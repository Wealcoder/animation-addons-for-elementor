{#
  AAE Table of Content — atomic leaf widget.

  Renders the box shell (header + collapsible body). table-of-contents.js scans
  the page headings and injects the <ol>/<ul> into .toc__body at runtime,
  reading every behavioural setting off the data-aae-toc-* attributes below.
  Colour Content-tab inputs bridge to CSS custom properties (--toc-*), matching
  aae-a-toggle-switcher.html.twig. Structural styling comes from the Style-tab
  base-style classes (base_styles.*), the rest from the on-demand stylesheet.

  CSS class names are kept identical to the Pro widget (toc__header,
  toc__body, toc__list-item, elementor-item-active, toc--collapsed, …) so the
  stylesheet and JS port over 1:1.
#}
{% set box_classes = ['aae-a-toc', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set html_tag = settings.html_tag | default('h4') %}
{% set valid_tags = ['h1','h2','h3','h4','h5','h6','div'] %}
{% if html_tag not in valid_tags %}{% set html_tag = 'h4' %}{% endif %}

{# Recompose the enabled heading levels into a comma-separated tag list for the JS. #}
{% set levels = [] %}
{% if settings.inc_h1 %}{% set levels = levels | merge(['h1']) %}{% endif %}
{% if settings.inc_h2 %}{% set levels = levels | merge(['h2']) %}{% endif %}
{% if settings.inc_h3 %}{% set levels = levels | merge(['h3']) %}{% endif %}
{% if settings.inc_h4 %}{% set levels = levels | merge(['h4']) %}{% endif %}
{% if settings.inc_h5 %}{% set levels = levels | merge(['h5']) %}{% endif %}
{% if settings.inc_h6 %}{% set levels = levels | merge(['h6']) %}{% endif %}
{% if levels is empty %}{% set levels = ['h2','h3','h4','h5','h6'] %}{% endif %}

{% set minimize     = settings.minimize_box ? 'true' : 'false' %}
{% set hierarchical = settings.hierarchical_view ? 'true' : 'false' %}
{% set collapse_sub = settings.collapse_subitems ? 'true' : 'false' %}

{# Colour → CSS var bridge. #}
{% set toc_vars = '' %}
{% if settings.item_text_color        is not empty %}{% set toc_vars = toc_vars ~ '--toc-item-text-color:'        ~ settings.item_text_color        ~ ';' %}{% endif %}
{% if settings.item_text_hover_color  is not empty %}{% set toc_vars = toc_vars ~ '--toc-item-text-hover-color:'  ~ settings.item_text_hover_color  ~ ';' %}{% endif %}
{% if settings.item_text_active_color is not empty %}{% set toc_vars = toc_vars ~ '--toc-item-text-active-color:' ~ settings.item_text_active_color ~ ';' %}{% endif %}
{% if settings.marker_color           is not empty %}{% set toc_vars = toc_vars ~ '--toc-marker-color:'           ~ settings.marker_color           ~ ';' %}{% endif %}
{% if settings.toggle_button_color    is not empty %}{% set toc_vars = toc_vars ~ '--toc-toggle-button-color:'    ~ settings.toggle_button_color    ~ ';' %}{% endif %}

{% set expand_icon_url   = settings.expand_icon.url   | default('') %}
{% set collapse_icon_url = settings.collapse_icon.url | default('') %}
{% set marker_icon_url   = settings.marker_icon.url   | default('') %}
{% set word_wrap_class   = settings.word_wrap ? ' toc--content-ellipsis' : '' %}
{% set minimized_class   = settings.minimize_box ? ' toc--minimized-on-' ~ (settings.minimized_on | default('tablet')) : '' %}

<div
    class="{{ box_classes }}{{ word_wrap_class }}{{ minimized_class }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    data-aae-toc-tags="{{ levels | join(',') | e('html_attr') }}"
    data-aae-toc-container="{{ settings.container | default('') | e('html_attr') }}"
    data-aae-toc-exclude="{{ settings.exclude_selector | default('') | e('html_attr') }}"
    data-aae-toc-marker="{{ settings.marker_view | default('numbers') | e('html_attr') }}"
    data-aae-toc-minimize="{{ minimize }}"
    data-aae-toc-minimized-on="{{ settings.minimized_on | default('tablet') | e('html_attr') }}"
    data-aae-toc-hierarchical="{{ hierarchical }}"
    data-aae-toc-collapse-subitems="{{ collapse_sub }}"
    {% if marker_icon_url is not empty %}data-aae-toc-marker-icon="{{ marker_icon_url | e('html_attr') }}"{% endif %}
    {% if toc_vars is not empty %}style="{{ toc_vars }}"{% endif %}
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
>
    {# aria-controls must name an ID, and aria-expanded belongs on the CONTROL,
       never on the region it controls — both live on the toggle buttons below.
       The header itself is a plain heading row and takes no ARIA. #}
    {% set toc_body_id = 'aae-toc-body-' ~ id %}
    <div class="toc__header {{ base_styles.header | default('') }}">
        <{{ html_tag }} class="toc__header-title {{ base_styles.header_title | default('') }}">{{ settings.title | default('Table of Contents') | e }}</{{ html_tag }}>
        {% if settings.minimize_box %}
            <div class="toc__toggle-button toc__toggle-button--expand" role="button" tabindex="0" aria-expanded="false" aria-controls="{{ toc_body_id }}" aria-label="{{ 'Open table of contents' | e('html_attr') }}">
                {% if expand_icon_url is not empty %}
                    <img src="{{ expand_icon_url | e('html_attr') }}" alt="" aria-hidden="true">
                {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                {% endif %}
            </div>
            <div class="toc__toggle-button toc__toggle-button--collapse" role="button" tabindex="0" aria-expanded="true" aria-controls="{{ toc_body_id }}" aria-label="{{ 'Close table of contents' | e('html_attr') }}">
                {% if collapse_icon_url is not empty %}
                    <img src="{{ collapse_icon_url | e('html_attr') }}" alt="" aria-hidden="true">
                {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6"/></svg>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div id="{{ toc_body_id }}" class="toc__body {{ base_styles.body | default('') }}{{ settings.collapse_subitems ? ' toc__list-items--collapsible' : '' }}">
        <div class="toc__spinner-container">
            <svg class="toc__spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
        </div>
    </div>
</div>
