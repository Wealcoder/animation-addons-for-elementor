{#
  AAE Hotspot Point — always a plain <div>, NEVER a real <button>/<a>.

  Content (a child of this element) always seeds a real <button> (the Close
  control) and may contain arbitrary user content, including links/buttons —
  a <button> or <a> can't legally contain another interactive element; real
  browsers auto-close the outer tag the instant they parse the inner one,
  silently popping everything after it out as trailing siblings (this is
  exactly the bug that had Close + the tooltip paragraph escaping onto the
  frontend, even though the editor — which builds the DOM via direct JS
  calls, never by parsing an HTML string — never showed it). image-hotspot.js
  wires click + Enter/Space keyboard activation (and link navigation for
  link mode) onto this div instead.
#}
{% set mode = settings.tooltip_type | default('tooltip') %}
{% set classes = ['aae-hotspot-point', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default(id) }}"
	data-aae-hotspot-mode="{{ mode }}"
	style="inset-inline-start: {{ settings.pos_left | default(50) }}%; inset-block-start: {{ settings.pos_top | default(50) }}%;"
	role="{{ mode == 'link' ? 'link' : 'button' }}"
	tabindex="0"
	{% if mode == 'link' %}
		{% if settings.tlp_link.href is defined and settings.tlp_link.href is not empty %}
			data-aae-hotspot-href="{{ settings.tlp_link.href | e('html_attr') }}"
			data-aae-hotspot-target="{{ settings.tlp_link.target | default('_self') | e('html_attr') }}"
		{% endif %}
		aria-label="{{ 'Open link' | e('html_attr') }}"
	{% else %}
		aria-haspopup="{{ mode == 'lightbox' ? 'dialog' : 'true' }}"
		aria-expanded="false"
		aria-label="{{ 'Toggle hotspot content' | e('html_attr') }}"
	{% endif %}
	{% if settings._cssid is defined and settings._cssid is not empty %}
		id="{{ settings._cssid | e('html_attr') }}"
	{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}
		{{ settings.attributes | raw }}
	{% endif %}
	{{ editor_attributes | default('') | raw }}>
	{{ children_placeholder | raw }}
</div>
