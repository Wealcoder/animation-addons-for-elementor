{#
  AAE Hotspot Content — the tooltip/lightbox box. `data-aae-hotspot-mode`
  comes from the ancestor Point's `tooltip_type` via Render_Context (see
  AAE_A_Hotspot_Point::define_render_context() and this class's own
  build_template_context()) — rendered here, server-side, so image-hotspot.
  scss's lightbox rule matches from first paint, before image-hotspot.js
  even runs. `role`/`aria-modal` are still set by that JS at init (they
  don't affect CSS matching, so no first-paint flash risk from those).
#}
{% set classes = ['aae-hotspot-content', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default('') }}"
	data-aae-hotspot-mode="{{ aae_hotspot_mode | default('tooltip') }}"
	{% if settings._cssid is defined and settings._cssid is not empty %}
		id="{{ settings._cssid | e('html_attr') }}"
	{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}
		{{ settings.attributes | raw }}
	{% endif %}
	{{ editor_attributes | default('') | raw }}>

	{{ children_placeholder | raw }}
</div>
