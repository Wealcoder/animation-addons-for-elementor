{#
  AAE Image Hotspot — parent template.

  Renders the wrapper + children_placeholder (background e-image + real
  e-aae-a-hotspot-point children render themselves). Global behavior/animation
  settings ride as data-aae-hsp-* attributes for image-hotspot.js to read —
  there is nothing left to compute server-side per point.
#}
{% set classes = ['aae-image-hotspot', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default('') }}"
	data-aae-hsp-trigger="{{ settings.trigger_type | default('hover') }}"
	data-aae-hsp-marker-anim="{{ settings.marker_anim | default('pulse') }}"
	data-aae-hsp-tour-enabled="{{ settings.tour_enabled | default(false) }}"
	data-aae-hsp-tour-delay="{{ settings.tour_delay | default(3000) }}"
	data-aae-hsp-tour-pause="{{ settings.tour_pause_on_interaction | default(true) }}"
	data-aae-hsp-tour-loop="{{ settings.tour_loop | default(true) }}"
	data-aae-hsp-tour-open="{{ settings.tour_open_tooltip | default(true) }}"
	style="--anim-speed: {{ settings.anim_speed | default(3) }}s;"
	{% if settings._cssid is defined and settings._cssid is not empty %}
		id="{{ settings._cssid | e('html_attr') }}"
	{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}
		{{ settings.attributes | raw }}
	{% endif %}
	{{ editor_attributes | default('') | raw }}>

	{{ children_placeholder | raw }}
</div>
