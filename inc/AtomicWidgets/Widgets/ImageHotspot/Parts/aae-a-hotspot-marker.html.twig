{#
  AAE Hotspot Marker — renders a plain <span> (decorative, aria-hidden). The
  Hotspot Point that contains this is a plain <div> with role="button"/"link"
  + tabindex (see aae-a-hotspot-point.html.twig) — image-hotspot.js wires the
  actual click/keyboard handling there, not on this span. data-layout/-anim
  feed image-hotspot.js (auto-numbering, marker animation class); everything
  visual is the base style (Style tab) plus the tiny per-layout size rule in
  image-hotspot.scss.
#}
{% set layout = settings.hsp_layout | default('dot') %}
{% set anim = settings.marker_anim | default('inherit') %}
{% set icon_url = settings.hsp_icon.url | default('') %}
{% set classes = ['aae-hotspot-marker', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<span class="{{ classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default(id) }}"
	data-layout="{{ layout }}"
	data-aae-hotspot-anim="{{ anim }}"
	{% if settings._cssid is defined and settings._cssid is not empty %}
		id="{{ settings._cssid | e('html_attr') }}"
	{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}
		{{ settings.attributes | raw }}
	{% endif %}
	{{ editor_attributes | default('') | raw }}
	aria-hidden="true">
	{% if layout == 'icon' or layout == 'icon-text' %}
		<span class="aae-hotspot-marker-icon">{% if icon_url is not empty %}<img src="{{ icon_url | e('html_attr') }}" alt="">{% else %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><circle cx="12" cy="12" r="8"/></svg>{% endif %}</span>
	{% endif %}
	{% if layout == 'text' or layout == 'icon-text' %}
		<span class="aae-hotspot-marker-text">{{ settings.hsp_text | default('') }}</span>
	{% endif %}
	{% if layout == 'number' %}
		<span class="hotspot-number"></span>
	{% endif %}
</span>
