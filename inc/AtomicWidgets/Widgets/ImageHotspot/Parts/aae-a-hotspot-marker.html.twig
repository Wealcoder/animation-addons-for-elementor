{#
  AAE Hotspot Marker — renders a <div> (decorative, aria-hidden). Was a plain
  <span> before this became a real container — a span is phrasing content and
  can't validly hold the block-level markup a builder-added e-svg/e-paragraph
  child renders, so this switched to <div> to match Point/Content's own
  choice. The Hotspot Point that contains this is itself a plain <div> with
  role="button"/"link" + tabindex (see aae-a-hotspot-point.html.twig) —
  image-hotspot.js wires the actual click/keyboard handling there, not here.
  `data-aae-hotspot-anim` feeds image-hotspot.js's marker-animation class;
  everything else visual is the base style (Style tab) plus whatever real
  e-svg/e-image/e-paragraph children a builder drops in (see
  class-aae-a-hotspot-marker.php docblock — empty by default, no more
  `hsp_layout` enum).
#}
{% set anim = settings.marker_anim | default('inherit') %}
{% set classes = ['aae-hotspot-marker', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default(id) }}"
	data-aae-hotspot-anim="{{ anim }}"
	{% if settings._cssid is defined and settings._cssid is not empty %}
		id="{{ settings._cssid | e('html_attr') }}"
	{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}
		{{ settings.attributes | raw }}
	{% endif %}
	{{ editor_attributes | default('') | raw }}
	aria-hidden="true">
	{{ children_placeholder | raw }}
</div>
