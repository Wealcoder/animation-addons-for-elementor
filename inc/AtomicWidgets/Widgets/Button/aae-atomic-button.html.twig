{# Detect which style group is active #}
{% set pro_styles = ['pro-1','pro-2','pro-3','pro-4','pro-5','pro-6','pro-7','pro-8'] %}
{% set is_pro     = settings.btn_style in pro_styles %}
{% set is_ext_wrap = (not is_pro) and settings.btn_style in ['oval', 'circle', 'ellipse'] %}

{# Build link rel attribute #}
{% if settings.btn_target == '_blank' %}
    {% set rel_attr = 'noopener' ~ (settings.btn_nofollow ? ' nofollow' : '') %}
{% elseif settings.btn_nofollow %}
    {% set rel_attr = 'nofollow' %}
{% else %}
    {% set rel_attr = '' %}
{% endif %}

{# Capture icon markup once — reused by pro styles only #}
{% set icon_html %}
    {% if settings.btn_show_icon %}
        {% if settings.btn_icon_svg is defined and settings.btn_icon_svg.html is defined and settings.btn_icon_svg.html is not empty %}
            {{ settings.btn_icon_svg.html | raw }}
        {% elseif settings.btn_icon_css is defined and settings.btn_icon_css is not empty %}
            <i class="{{ settings.btn_icon_css }}" aria-hidden="true"></i>
        {% endif %}
    {% endif %}
{% endset %}
{% set has_icon = icon_html | trim is not empty %}

{# Icon size + color — used only for classic styles #}
{% set icon_size  = settings.btn_icon_size | default(20) %}
{% set icon_color = settings.btn_icon_color | default('') %}
{% set icon_color_css = icon_color ? 'color:' ~ icon_color ~ ';fill:' ~ icon_color ~ ';' : '' %}

{# Classic link classes — not needed for pro styles #}
{% if not is_pro %}
    {% set link_classes = [
        'wcf-btn-' ~ (settings.btn_style | default('default')),
        'btn-' ~ (settings.btn_hover_style | default('hover-none')),
        base_styles.base
    ] | merge(settings.classes | default([])) %}

    {% if is_ext_wrap %}
        {% set link_classes = link_classes | merge(['btn-item']) %}
        {% if settings.btn_style != 'ellipse' %}
            {% set link_classes = link_classes | merge(['btn-hover-bgchange']) %}
        {% endif %}
    {% endif %}
{% endif %}

{# Build inline style string — text-align + CSS custom properties for user colors #}
{% set inline_style = 'text-align: ' ~ (settings.btn_alignment | default('center')) ~ ';' %}
{% if settings.btn_color is defined and settings.btn_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-color:' ~ settings.btn_color ~ ';' %}
{% endif %}
{% if settings.btn_bg_color is defined and settings.btn_bg_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-bg:' ~ settings.btn_bg_color ~ ';' %}
{% endif %}
{% if settings.btn_border_color is defined and settings.btn_border_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-border-color:' ~ settings.btn_border_color ~ ';' %}
{% endif %}
{% if settings.btn_hover_color is defined and settings.btn_hover_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-hover-color:' ~ settings.btn_hover_color ~ ';' %}
{% endif %}
{% if settings.btn_hover_bg_color is defined and settings.btn_hover_bg_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-hover-bg:' ~ settings.btn_hover_bg_color ~ ';' %}
{% endif %}
{% if settings.btn_hover_border_color is defined and settings.btn_hover_border_color is not empty %}
    {% set inline_style = inline_style ~ '--aae-btn-hover-border-color:' ~ settings.btn_hover_border_color ~ ';' %}
{% endif %}

{# Outer wrapper — same for every style #}
<div class="aae-atomic-button e-atomic-element {{ editor_classes | default('') }}"
     data-id="{{ id }}"
     data-e-type="{{ type }}"
     data-interaction-id="{{ interaction_id | default('') }}"
     style="{{ inline_style }}"
     {% if settings._cssid is defined and settings._cssid is not empty %}
         id="{{ settings._cssid | e('html_attr') }}"
     {% endif %}
     {% if settings.attributes is defined and settings.attributes is not empty %}
         {{ settings.attributes | default('') | raw }}
     {% endif %}
     {{ editor_attributes | default('') | raw }}>

    {% if is_pro %}
        {# ────────────────────────────────────────────────
           PRO STYLES  (pro-1 … pro-8)
        ──────────────────────────────────────────────── #}
        {% set pro_num      = settings.btn_style | replace({'pro-': ''}) %}
        {% set extra_classes = settings.classes | default([]) | join(' ') %}

        <div class="aae--btn-pro-wrapper style-{{ pro_num }}">

            {% if pro_num == '1' %}
                {# Border-divide: duplicated icon slides in/out on hover #}
                <a class="aae--btn-pro btn-border-divide {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    <span class="text">{{ settings.btn_text | default('Click here') | e }}</span>
                    {% if has_icon %}
                        <span class="icon">
                            {{ icon_html | raw }}
                            {{ icon_html | raw }}
                        </span>
                    {% endif %}
                </a>

            {% elseif pro_num == '2' %}
                {# Shadow on hover #}
                <a class="aae--btn-pro {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    {{ settings.btn_text | default('Click here') | e }}
                    {% if has_icon %}<span class="icon">{{ icon_html | raw }}</span>{% endif %}
                </a>

            {% elseif pro_num == '3' %}
                {# 3-D text flip on hover #}
                <a class="aae--btn-pro btn-text-flip {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    <span data-text="{{ settings.btn_text | default('Click here') | e('html_attr') }}">
                        {{ settings.btn_text | default('Click here') | e }}
                    </span>
                    {{ icon_html | raw }}
                </a>

            {% elseif pro_num == '4' %}
                {# Ripple at cursor — JS driven, targets .btn-hover #}
                <a class="aae--btn-pro btn-hover {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    <span></span>
                    {{ settings.btn_text | default('Click here') | e }}
                    <strong></strong>
                </a>

            {% elseif pro_num in ['5', '6'] %}
                {# Icon group — icon slides in/out from opposite side #}
                <a class="aae-btn-pro-group {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    <span class="g-btn-icon">{{ icon_html | raw }}</span>
                    <span class="g-btn-text">{{ settings.btn_text | default('Click here') | e }}</span>
                    <span class="g-btn-icon">{{ icon_html | raw }}</span>
                </a>

            {% elseif pro_num == '7' %}
                {# Outline pill — inner fill shrinks away on hover; gap is user-controlled #}
                <a class="aae--btn-pro {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
                   style="--outline-gap: {{ settings.btn_outline_gap | default(10) }}px;">
                    {{ settings.btn_text | default('Click here') | e }}
                    {% if has_icon %}<span class="icon">{{ icon_html | raw }}</span>{% endif %}
                </a>

            {% elseif pro_num == '8' %}
                {# Slide-fill: white background slides out on hover #}
                <a class="aae--btn-pro {{ base_styles.base }} {{ extra_classes }}"
                   href="{{ settings.btn_url | default('#') | e('html_attr') }}"
                   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
                   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}>
                    {{ settings.btn_text | default('Click here') | e }}
                    {% if has_icon %}<span class="icon">{{ icon_html | raw }}</span>{% endif %}
                </a>
            {% endif %}

        </div>

    {% else %}
        {# ────────────────────────────────────────────────
           CLASSIC STYLES  (default / square / underline / mask / oval / circle / ellipse)
        ──────────────────────────────────────────────── #}
        <div class="wcf__btn {{ settings.btn_icon_position == 'right' ? 'icon-position-after' : '' }}">

            {% if is_ext_wrap %}<div class="btn-wrapper">{% endif %}

            <a class="{{ link_classes | join(' ') }}"
               href="{{ settings.btn_url | default('#') | e('html_attr') }}"
               {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
               {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
               {% if settings.btn_style == 'mask' %}data-text="{{ settings.btn_text | default('') | e('html_attr') }}"{% endif %}>

                {% if settings.btn_show_icon %}
                    {% if settings.btn_icon_svg is defined and settings.btn_icon_svg.html is defined and settings.btn_icon_svg.html is not empty %}
                        <span class="aae-btn-icon-svg"
                              style="width:{{ icon_size }}px;height:{{ icon_size }}px;{{ icon_color_css }}"
                              aria-hidden="true">
                            {{ settings.btn_icon_svg.html | raw }}
                        </span>
                    {% elseif settings.btn_icon_css is defined and settings.btn_icon_css is not empty %}
                        <i class="{{ settings.btn_icon_css }}"
                           style="font-size:{{ icon_size }}px;{{ icon_color_css }}"
                           aria-hidden="true"></i>
                    {% endif %}
                {% endif %}

                {{ settings.btn_text | default('Click here') | e }}

            </a>

            {% if is_ext_wrap %}</div>{% endif %}

        </div>
    {% endif %}

</div>
