{% import 'elementor/macros' as m %}
{% set tag = settings.tag | default('span') %}
{% set classes = ['aae-a-comment-author'] | merge([ base_styles.base ]) | merge(settings.classes | default([])) | join(' ') %}
<{{ tag }} class="{{ classes }}" data-interaction-id="{{ interaction_id | default('') }}" {{- m.render_custom_attributes(settings) }}>
    {{ settings.author_html | default('') | raw }}
</{{ tag }}>
