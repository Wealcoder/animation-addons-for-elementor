{% import 'elementor/macros' as m %}
{% set classes = ['aae-a-comment-avatar'] | merge([ base_styles.base ]) | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }}" data-interaction-id="{{ interaction_id | default('') }}" {{- m.render_custom_attributes(settings) }}>
    {{ settings.avatar_html | default('') | raw }}
</div>
