{
    "name": "Newsletter",
    "model": {
        "elType": "e-aae-a-form",
        "settings": [],
        "elements": [
            {
                "elType": "widget",
                "widgetType": "e-aae-a-form-label",
                "settings": {
                    "text": {
                        "$$type": "html-v3",
                        "value": {
                            "content": { "$$type": "string", "value": "Email address" },
                            "children": []
                        }
                    },
                    "input-id": { "$$type": "string", "value": "aae-news-email" }
                },
                "elements": []
            },
            {
                "elType": "widget",
                "widgetType": "e-aae-a-form-input",
                "settings": {
                    "type": { "$$type": "string", "value": "email" },
                    "placeholder": { "$$type": "string", "value": "your@mail.com" },
                    "required": { "$$type": "boolean", "value": true },
                    "_cssid": { "$$type": "string", "value": "aae-news-email" }
                },
                "elements": []
            },
            {
                "elType": "widget",
                "widgetType": "e-aae-a-form-submit",
                "settings": {
                    "text": {
                        "$$type": "html-v3",
                        "value": {
                            "content": { "$$type": "string", "value": "Subscribe" },
                            "children": []
                        }
                    },
                    "loading_label": { "$$type": "string", "value": "Subscribing..." }
                },
                "elements": []
            },
            {
                "elType": "e-aae-a-form-success-message",
                "settings": [],
                "elements": [
                    {
                        "elType": "widget",
                        "widgetType": "e-paragraph",
                        "settings": {
                            "paragraph": {
                                "$$type": "html-v3",
                                "value": {
                                    "content": { "$$type": "string", "value": "You’re on the list! Check your inbox to confirm." },
                                    "children": []
                                }
                            }
                        },
                        "elements": []
                    }
                ]
            },
            {
                "elType": "e-aae-a-form-error-message",
                "settings": [],
                "elements": [
                    {
                        "elType": "widget",
                        "widgetType": "e-paragraph",
                        "settings": {
                            "paragraph": {
                                "$$type": "html-v3",
                                "value": {
                                    "content": { "$$type": "string", "value": "Subscription failed. Please try again." },
                                    "children": []
                                }
                            }
                        },
                        "elements": []
                    }
                ]
            }
        ]
    }
}
