{#
  AAE Form Message — shared template for the Success/Error message
  containers. Hidden via the base style (display:none); revealed by the
  form's form-state-{value} class (rule in form.scss). role/aria-live make
  the reveal announced by screen readers.
#}
{% set is_success = type == 'e-aae-a-form-success-message' %}
{% set classes = ['aae-a-form-message', is_success ? 'aae-a-form-message--success' : 'aae-a-form-message--error', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    role="{{ is_success ? 'status' : 'alert' }}"
    aria-live="{{ is_success ? 'polite' : 'assertive' }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</div>
