{#
  AAE Form Country — single <select> whose options come from the `options`
  prop (one line per country, "code|Name|selected"; the default is the full
  built-in ISO list). Same parsing as the Select widget's twig, minus
  `multiple`, plus autocomplete="country-name" for browser autofill. name
  falls back to _cssid, then element id.
#}
{% set classes = ['aae-a-form-country', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set input_name = settings.name is defined and settings.name is not empty ? settings.name : (settings._cssid is defined and settings._cssid is not empty ? settings._cssid : id) %}
{% set placeholder = settings.placeholder | default('') | trim %}

<select
    class="{{ classes }} {{ editor_classes | default('') }}"
    name="{{ input_name | e('html_attr') }}"
    autocomplete="country-name"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if placeholder is not empty %}data-placeholder="{{ placeholder | e('html_attr') }}"{% endif %}
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.required %}required aria-required="true"{% endif %}
    {% if settings.error_message is defined and settings.error_message is not empty %}data-aae-error-message="{{ settings.error_message | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
>
    {% if placeholder is not empty %}
        <option value="" disabled selected hidden>{{ placeholder }}</option>
    {% endif %}
    {% for line in (settings.options | default('')) | split('\n') %}
        {% if line | trim is not empty %}
            {% set parts = line | split('|') %}
            {% set opt_value = (parts[0] | default('')) | trim %}
            {% set opt_label = (parts[1] | default(opt_value)) | trim %}
            {% set opt_selected = (parts[2] | default('')) | trim | lower == 'selected' %}
            <option value="{{ opt_value | e('html_attr') }}"{% if opt_selected %} selected{% endif %}>{{ opt_label }}</option>
        {% endif %}
    {% endfor %}
</select>
