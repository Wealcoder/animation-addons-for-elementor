{#
  AAE Form Input — renders a single <input> of a text-family type.
  Linked to its label via _cssid (label's input-id points here → for=/id=).
  name falls back to _cssid, then element id, so submitted data always has a key.
#}
{% set classes = ['aae-a-form-input', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set input_name = settings.name is defined and settings.name is not empty ? settings.name : (settings._cssid is defined and settings._cssid is not empty ? settings._cssid : id) %}

{# Placeholder colour can't go through base styles (atomic has no pseudo-element
   support), so scope it to this input's data-id and inherit the input's own
   Text Color (Style panel → Color) at reduced opacity — change Text Color and
   the placeholder follows. Renders on editor + frontend. #}
<style>
    [data-id="{{ id }}"]::placeholder { color: inherit; opacity: 0.6; }
    [data-id="{{ id }}"]::-webkit-input-placeholder { color: inherit; opacity: 0.6; }
    [data-id="{{ id }}"]::-moz-placeholder { color: inherit; opacity: 0.6; }
</style>
<input
    class="{{ classes }} {{ editor_classes | default('') }}"
    type="{{ settings.type | default('text') }}"
    name="{{ input_name | e('html_attr') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.placeholder is defined and settings.placeholder is not empty %}placeholder="{{ settings.placeholder | e('html_attr') }}"{% endif %}
    {% if settings.required %}required aria-required="true"{% endif %}
    {% if settings.readonly %}readonly{% endif %}
    {% if settings.min is defined and settings.min is not empty %}min="{{ settings.min | e('html_attr') }}"{% endif %}
    {% if settings.max is defined and settings.max is not empty %}max="{{ settings.max | e('html_attr') }}"{% endif %}
    {% if settings.error_message is defined and settings.error_message is not empty %}data-aae-error-message="{{ settings.error_message | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
/>
