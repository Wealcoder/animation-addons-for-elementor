{% set pb_style = settings.pb_style | default('1') %}
{% set progress_map = {'1': 'line', '2': 'circle', '3': 'dot'} %}
{% set progress_type = progress_map[pb_style] | default('line') %}

{#
  Critical layout is forced inline so it can never be overridden by Elementor's
  .e-con stylesheet (which differs between editor and frontend in specificity).
  Line:   position:relative keeps .aae-pb-pct anchored; padding-top reserves
          space above the bar for the percentage text.
  Circle: explicit dimensions + position:relative for the centered .aae-pb-pct.
          Default 150 × 150 px — override via Elementor custom CSS if needed.
#}
{% set inline_style = '' %}
{% if pb_style == '1' %}
    {% set inline_style = 'position:relative;padding-top:1.8em;' %}
{% elseif pb_style == '2' %}
    {% set inline_style = 'position:relative;display:block;' %}
{% endif %}

{% set wrapper_classes = ['e-con', 'e-atomic-element', base_styles.base, 'wcf__progressbar-main', 'style-' ~ pb_style] | merge(settings.classes | default([])) | join(' ') %}

<div class="{{ wrapper_classes }} {{ editor_classes | default('') }}"
     data-id="{{ id }}"
     data-element_type="{{ type }}"
     data-e-type="{{ type }}"
     data-interaction-id="{{ interaction_id | default('') }}"
     data-pb-type="{{ progress_type }}"
     data-pb-percentage="{{ settings.pb_percentage | default(50) }}"
     data-pb-display-percentage="{{ settings.pb_display_percentage ? 'true' : 'false' }}"
     data-pb-track-height="{{ settings.pb_track_height | default(8) }}"
     data-pb-stroke-width="{{ settings.pb_stroke_width | default(10) }}"
     {% if inline_style is not empty %}style="{{ inline_style }}"{% endif %}
     {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
     {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
     {{ editor_attributes | default('') | raw }}>

    {% if pb_style == '3' %}
        {# Dot — plain spans, all styling via CSS / Elementor native controls #}
        <div class="progressbar dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>

    {% elseif pb_style == '2' %}
        {#
          Circle — inline SVG so stroke colours follow currentColor (the widget's
          text-color control in Elementor) and stroke-width is overridable via CSS.
          r=40 → circumference = 2π×40 ≈ 251.327.  JS animates stroke-dashoffset.
        #}
        <svg class="progressbar" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="progressbar-trail" cx="50" cy="50" r="40"/>
            <circle class="progressbar-path"
                    cx="50" cy="50" r="40"
                    stroke-dasharray="251.327"
                    stroke-dashoffset="251.327"
                    transform="rotate(-90 50 50)"/>
        </svg>

    {% else %}
        {# Line — two divs: track + animated fill.  JS sets fill width via CSS var. #}
        <div class="progressbar">
            <div class="progressbar-fill"></div>
        </div>
    {% endif %}

    {{ children_placeholder | raw }}

</div>
