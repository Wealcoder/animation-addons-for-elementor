{% import 'elementor/macros' as m %}
{%- set classes = ['aae-progressbar-track', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') -%}
<div class="{{ classes }} {{ editor_classes | default('') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ children_placeholder | raw }}
</div>
