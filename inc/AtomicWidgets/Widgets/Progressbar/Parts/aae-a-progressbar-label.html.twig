{% import 'elementor/macros' as m %}
{#
	`aae-pb-pct` is progressbar.js's hook for the percentage counter. It is
	rendered here rather than seeded into the `classes` prop (as it was) because
	Elementor's panel resolves every entry in `classes` against the style
	repository and flags anything that isn't a registered global/local style as
	"Some classes are missing" — and that alert's dismiss button UNAPPLIES the
	listed classes, silently breaking the counter. Same reason the track twig
	hardcodes `aae-progressbar-track`.
#}
{%- set classes = ['aae-pb-pct', base_styles.base] | merge( settings.classes | default([]) ) | join(' ') -%}
<{{ settings.tag | default('span') | e('html_tag') }} class="{{ classes }} {{ editor_classes | default('') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ settings.text | striptags('<b><strong><sup><sub><s><em><u><span><br>') | raw }}
</{{ settings.tag | default('span') | e('html_tag') }}>
