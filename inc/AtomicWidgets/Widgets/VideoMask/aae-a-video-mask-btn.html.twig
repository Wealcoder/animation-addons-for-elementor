{% set btn_classes = ['aae-a-video-mask-btn', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') %}

<div class="{{ btn_classes }} {{ editor_classes | default('') }}"
     data-id="{{ id }}"
     data-element_type="{{ type }}"
     data-e-type="{{ type }}"
     data-interaction-id="{{ interaction_id | default('') }}"
     {% if settings.attributes is defined and settings.attributes is not empty %}
         {{ settings.attributes | raw }}
     {% endif %}
     {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
    <span class="vm-close-title">{{ settings.vm_close_title | default('Close Video') | e }}</span>
</div>
