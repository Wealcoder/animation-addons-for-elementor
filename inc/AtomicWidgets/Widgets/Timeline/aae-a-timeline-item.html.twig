{% set classes = ['aae-a-timeline-item', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {#
        Two things the native Style panel can't express, so they're baked
        in as sensible defaults here instead:

          1. The connecting "spine" — a single-side border (inline-start
             only). The atomic Border control only exposes uniform
             all-side width/style/color, not a per-side shorthand, so a
             left-only rail has to be set directly. `currentColor` keeps
             it controllable from the native Text Color control on this
             element's own Style panel.

          2. The marker's negative-inset default position, so a freshly
             dropped item already reads as a timeline dot instead of
             sitting flush at (0,0). Every ready-made template in
             z_temp/templates/Timeline overrides both via its own local
             per-element styles — this is only the out-of-the-box look.
    #}
    <style>
        :where([data-id="{{ id }}"]) {
            border-inline-start: 2px solid currentColor;
        }
        :where([data-id="{{ id }}"]) .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 0;
            inset-inline-start: -11px;
        }
    </style>

    {{ children_placeholder | raw }}
</div>
