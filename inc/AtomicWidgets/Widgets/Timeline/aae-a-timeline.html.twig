{% set classes = ['aae-a-timeline', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
{% set preset = settings.preset | default('editorial-rail') %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-preset="{{ preset | e('html_attr') }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {#
        Preset CSS bank — TWO specificity tiers per preset:

        1. STRUCTURAL rules   →  `[data-id][data-preset] .child`  →  (0,3,0)
           Layout/positioning the preset needs to function: parent
           display/grid, item padding for marker clearance, marker
           position/inset. Higher than `.e-con` (0,1,0) defaults that
           would otherwise zero out our padding and break the layout.
           Trade-off: user's Style panel (0,1,0) can NOT override these.

        2. VISUAL rules        →  `:where([data-id][data-preset] .child)`  →  (0,0,0)
           Colors, fonts, sizes, shadows, borders, etc. Wrapped in
           `:where()` so specificity drops to 0 and Elementor's
           Style-panel local-style rules (0,1,0) ALWAYS win.

        Want a different layout? Pick another preset. Want different
        colors/typography? Use the Style panel on each child — it works.
    #}
    <style>
        /* Spine divider — hidden in every preset BY default, then
           re-shown + repositioned by the presets that need a parent-
           level spine (currently `social`). Descendant selector (no
           `>`) used so editor wrappers around the <hr> don't break
           the match. Atomic_Divider's own base styles emit a 1px-tall
           black <hr>; the social preset block below explicitly
           overrides height, width, background-color, background-image,
           border, and position to turn it into a vertical dotted line. */
        [data-id="{{ id }}"] .aae-a-timeline-spine {
            display: none;
        }

        /* ═════════════════════════════════════════════════════
           EDITORIAL RAIL (default) — green vertical spine
           ═════════════════════════════════════════════════════ */
        [data-id="{{ id }}"][data-preset="editorial-rail"] {
            display: flex;
            flex-direction: column;
            max-width: 720px;
            padding-block: 16px;
        }
        [data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item {
            padding-inline-start: 32px;
            padding-block-end: 32px;
        }
        [data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 0;
            inset-inline-start: -11px;
        }
        :where([data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item) {
            border-inline-start: 2px solid #bbf7d0;
        }
        :where([data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item-marker) {
            width: 22px; height: 22px;
            display: flex; align-items: center; justify-content: center;
            background: #16a34a; color: #fff;
            border-radius: 50%;
            box-shadow: 0 0 0 4px #f0fdf4;
            font-size: 10px; font-weight: 800; line-height: 1;
            z-index: 2;
        }
        :where([data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item-date)  { color: #15803d; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
        :where([data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item-title) { color: #0f172a; font-size: 20px; font-weight: 700; line-height: 1.2; }
        :where([data-id="{{ id }}"][data-preset="editorial-rail"] .aae-a-timeline-item-desc)  { color: #475569; font-size: 14px; line-height: 1.6; }

        /* ═════════════════════════════════════════════════════
           HERITAGE SPLIT — warm orange spine
           ═════════════════════════════════════════════════════ */
        [data-id="{{ id }}"][data-preset="heritage-split"] {
            display: flex;
            flex-direction: column;
            max-width: 720px;
            padding: 32px 28px;
        }
        [data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item {
            padding-inline-start: 42px;
            padding-block-end: 32px;
        }
        [data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 0;
            inset-inline-start: -18px;
        }
        :where([data-id="{{ id }}"][data-preset="heritage-split"]) {
            background: linear-gradient(180deg, #fef9f4, #fff5e9);
            border: 1px solid #f4ae88;
            border-radius: 14px;
            box-shadow: 0 18px 50px rgba(120,46,16,.10);
        }
        :where([data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item) {
            border-inline-start: 3px solid #f4ae88;
        }
        :where([data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item-marker) {
            width: 36px; height: 36px;
            display: flex; align-items: center; justify-content: center;
            background: #c0502a; color: #fff;
            border-radius: 50%;
            box-shadow: 0 0 0 6px #fef9f4, 0 8px 20px rgba(192,80,42,.30);
            font-size: 12px; font-weight: 800; line-height: 1;
            z-index: 2;
        }
        :where([data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item-date)  { color: #c0502a; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
        :where([data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item-title) { color: #7c2d12; font-size: 20px; font-weight: 700; line-height: 1.2; }
        :where([data-id="{{ id }}"][data-preset="heritage-split"] .aae-a-timeline-item-desc)  { color: #92400e; font-size: 14px; line-height: 1.6; }

        /* ═════════════════════════════════════════════════════
           ROADMAP TRACK — horizontal connected markers + cards
           Date floats above each card; markers sit on a continuous
           horizontal line drawn via a background-gradient on the
           parent (no extra DOM needed); the third item is shown as
           the "active" step (filled blue) via :nth-child.
           ═════════════════════════════════════════════════════ */
        [data-id="{{ id }}"][data-preset="roadmap-track"] {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            max-width: 1120px;
            padding: 100px 28px 28px;
            background-image: linear-gradient(to bottom,
                transparent 0, transparent 81px,
                #cbd5e1 81px, #cbd5e1 83px,
                transparent 83px);
            background-repeat: no-repeat;
        }
        [data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item {
            padding: 22px;
            gap: 8px;
        }
        [data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-date {
            position: absolute;
            inset-block-start: -78px;
            inset-inline-start: 0;
        }
        [data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: -28px;
            inset-inline-start: 0;
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"]) {
            background-color: #f8fafc;
            border-radius: 14px;
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item) {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 4px 14px rgba(15,23,42,.05);
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-marker) {
            width: 22px; height: 22px;
            display: flex; align-items: center; justify-content: center;
            background: #fff;
            color: #64748b;
            border: 2px solid #94a3b8;
            border-radius: 50%;
            font-size: 9px; font-weight: 700; line-height: 1;
            z-index: 2;
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item:nth-child(3) .aae-a-timeline-item-marker) {
            background: #2563eb;
            color: #fff;
            border-color: #2563eb;
            box-shadow: 0 0 0 5px rgba(37,99,235,.16);
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-date) {
            color: #0f172a;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -.02em;
            text-transform: none;
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-title) {
            color: #0f172a;
            font-size: 18px;
            font-weight: 700;
            line-height: 1.2;
        }
        :where([data-id="{{ id }}"][data-preset="roadmap-track"] .aae-a-timeline-item-desc) {
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
        }

        /* ═════════════════════════════════════════════════════
           CASE STUDY STEPS — bold navy, square marker
           ═════════════════════════════════════════════════════ */
        [data-id="{{ id }}"][data-preset="case-study"] {
            display: flex;
            flex-direction: column;
            max-width: 720px;
            gap: 18px;
            padding-block: 16px;
        }
        [data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item {
            padding-inline-start: 48px;
            padding-block-end: 28px;
        }
        [data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 0;
            inset-inline-start: -24px;
        }
        :where([data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item) {
            border-inline-start: 4px solid #0f172a;
        }
        :where([data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item-marker) {
            width: 48px; height: 48px;
            display: flex; align-items: center; justify-content: center;
            background: #0f172a; color: #fff;
            border-radius: 10px;
            box-shadow: 0 8px 20px rgba(15,23,42,.22);
            font-size: 15px; font-weight: 800;
        }
        :where([data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item-date)  { color: #fff; background: #0f172a; padding: 6px 12px; border-radius: 999px; align-self: start; font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
        :where([data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item-title) { color: #0f172a; font-size: 22px; font-weight: 700; line-height: 1.2; }
        :where([data-id="{{ id }}"][data-preset="case-study"] .aae-a-timeline-item-desc)  { color: #475569; font-size: 14px; line-height: 1.6; }

        /* ═════════════════════════════════════════════════════
           SOCIAL — purple alternating split with dotted spine
           Cards alternate left/right around a centered dotted
           vertical line drawn by the dedicated `.aae-a-timeline-spine`
           Atomic_Divider child — so the user can select & restyle it
           from the Style panel. Markers sit on the spine via absolute
           positioning + a transform that re-centers them onto the
           parent's centerline regardless of card width.
           ═════════════════════════════════════════════════════ */
        [data-id="{{ id }}"][data-preset="social"] {
            display: flex;
            flex-direction: column;
            gap: 32px;
            max-width: 720px;
            padding: 40px 0;
            margin-inline: auto;
            position: relative;
        }
        /* Spine — STRUCTURAL: anchored positioning + `display: block`
           MUST be at (0,3,0) so they beat the universal hide rule
           above (0,2,0). `transform: translateX(-50%)` centers the
           spine on the parent's centerline regardless of the border
           width chosen by the user. */
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-spine {
            display: block;
            position: absolute;
            inset-block-start: 16px;
            inset-block-end: 16px;
            inset-inline-start: 50%;
            inset-inline-end: auto;
            transform: translateX(-50%);
            z-index: 0;
        }
        /* Spine — VISUAL: the dotted line IS a left border on a
           zero-width element. Wrapped in `:where()` so every
           property is fully overridable from the Style panel.
           Use the Border section to recolor / re-thickness / swap
           the dotted pattern for solid or dashed. NOT using
           `mask-image` here because masks would clip the border
           too and confuse Style-panel border tweaks. */
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-spine) {
            width: 0;
            height: auto;
            margin: 0;
            padding: 0;
            background: none;
            border-block-start: 0;
            border-block-end: 0;
            border-inline-end: 0;
            border-inline-start: 2px dotted #c4b5fd;
            font-size: 0;
            line-height: 0;
        }
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item {
            width: calc(50% - 24px);
            padding: 20px;
            z-index: 1;
        }
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item:nth-child(odd) {
            align-self: flex-start;
        }
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item:nth-child(even) {
            align-self: flex-end;
        }
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item:nth-child(odd) .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 24px;
            inset-inline-end: -24px;
            inset-inline-start: auto;
            transform: translateX(50%);
        }
        [data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item:nth-child(even) .aae-a-timeline-item-marker {
            position: absolute;
            inset-block-start: 24px;
            inset-inline-start: -24px;
            inset-inline-end: auto;
            transform: translateX(-50%);
        }
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item) {
            background: #fff;
            border-radius: 14px;
            box-shadow:
                0 1px 2px rgba(15,23,42,.04),
                0 8px 24px rgba(124,58,237,.10);
        }
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item-marker) {
            width: 14px; height: 14px;
            background: #7c3aed;
            color: transparent;
            border-radius: 50%;
            box-shadow: 0 0 0 4px #fff, 0 0 0 5px #c4b5fd;
            font-size: 0;
            z-index: 2;
        }
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item-date) {
            color: #7c3aed;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item-title) {
            color: #18181b;
            font-size: 17px;
            font-weight: 700;
            line-height: 1.3;
        }
        :where([data-id="{{ id }}"][data-preset="social"] .aae-a-timeline-item-desc) {
            color: #52525b;
            font-size: 14px;
            line-height: 1.55;
        }

    </style>

    {{ children_placeholder | raw }}
</div>
