{% import 'elementor/macros' as m %}
{# `aae-a-timeline-item-title` is a plain CSS hook, not an Elementor style-def id — see
   the matching comment in aae-a-timeline-number.html.twig. #}
{# …plus `m.default_tag_class(…)`, the `e-default-<tag>` hook for Design System >
   Defaults. It takes the RESOLVED tag, not a literal, because this part's tag is
   a prop: the class has to name the element actually rendered. See
   aae-a-timeline.html.twig for the cascade reasoning. #}
{%- set classes = [ 'aae-a-timeline-item-title' ] | merge( settings.classes | default([]) ) | merge( [ base_styles.base, m.default_tag_class( settings.tag | default('h3') ) ] ) | join(' ') -%}
<{{ settings.tag | default('h3') | e('html_tag') }} class="{{ classes }} {{ editor_classes | default('') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ settings.text | striptags('<b><strong><sup><sub><s><em><u><span><br>') | raw }}
</{{ settings.tag | default('h3') | e('html_tag') }}>
