{% import 'elementor/macros' as m %}
{# `aae-a-timeline-item-marker` is the part's semantic hook — a plain CSS class
   (the item twig's marker rule keys off it), NOT an Elementor style-def id. It
   used to be seeded into the `classes` prop, but the editor resolves every
   entry there to a local or global class and warns "Some classes are missing"
   for the ones it can't; dismissing that alert calls unapplyClasses(), which
   strips the hook off the element for good. Emitting it here keeps the markup
   identical while the panel stays clean. #}
{# …plus `m.default_tag_class(…)`, the `e-default-<tag>` hook for Design System >
   Defaults. It takes the RESOLVED tag, not a literal, because this part's tag is
   a prop: the class has to name the element actually rendered. See
   aae-a-timeline.html.twig for the cascade reasoning. #}
{%- set classes = [ 'aae-a-timeline-item-marker' ] | merge( settings.classes | default([]) ) | merge( [ base_styles.base, m.default_tag_class( settings.tag | default('span') ) ] ) | join(' ') -%}
<{{ settings.tag | default('span') | e('html_tag') }} class="{{ classes }} {{ editor_classes | default('') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ settings.text | striptags('<b><strong><sup><sub><s><em><u><span><br>') | raw }}
</{{ settings.tag | default('span') | e('html_tag') }}>
