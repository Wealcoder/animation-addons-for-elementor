{#
  AAE Toggle Switcher — Label. Renders the aae-ts-label-before/after hook
  class unconditionally from `is_after`, never from settings.classes — see
  the class docblock for why. toggle-switcher.js selects/toggles this class
  at runtime; it must survive the panel's "missing classes" dismiss, which
  only ever touches the `classes` prop.
#}
{%- set legacy_classes = settings.classes | default([]) -%}
{%- set is_after = (settings.is_after | default(false)) or ('aae-ts-label-after' in legacy_classes) -%}
{%- set position_class = is_after ? 'aae-ts-label-after' : 'aae-ts-label-before' -%}
{%- set classes = [position_class, 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(legacy_classes) | join(' ') | trim -%}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</div>
