{#
  AAE Toggle Switcher — Knob. Renders the aae-ts-knob hook class
  unconditionally from its own twig, never from settings.classes — see the
  class docblock. Purely a CSS hook (toggle-switcher.scss moves it via
  `.aae-ts-switch.active .aae-ts-knob`); nothing reads it from JS.
#}
{%- set classes = ['aae-ts-knob', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim -%}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
</div>
