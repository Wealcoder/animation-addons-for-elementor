{% import 'elementor/macros' as m %}
{# `m.default_tag_class(tag)` emits `e-default-<tag>`, the hook Elementor's
   Design System > Defaults writes against — see aae-a-accordion.html.twig for
   the cascade reasoning, which is the same here.

   It goes on the three surfaces that carry a base-style class, because those
   are the parts a builder can style and therefore the parts a default should
   reach: this root `div` (base), the header `button` (header) and the content
   `div` (content). Core does the same — its Heading puts the class on the inner
   link too, not only on the root.

   Deliberately NOT on the other three elements here. `.aae-children-injector`
   is `display:none` plumbing. `.aae-accordion-content-wrapper` is the element
   accordion.js animates the height of. The `{{ heading_tag }}` wrapper is a
   semantic shell with no base-style class and no panel control any more (the
   `title_html_tag` control is commented out in class-aae-a-accordion-item.php);
   the visible title is a child Atomic_Heading that already carries core's own
   default-tag class for whatever H-level it is set to.

   Note what a default CANNOT reach: the header button and the content div each
   carry an inline `style` attribute, and inline beats every class rule. On the
   button that is display/align-items/justify-content/width/background/border/
   cursor; on the content div, display/flex-direction/gap. A `button` or `div`
   default still lands on everything else — colour, font, padding, radius. #}
{% set is_active_class = settings.is_active ? 'active' : '' %}
{% set classes = ['aae-a-accordion-item', 'e-con', 'e-atomic-element', base_styles.base, is_active_class, m.default_tag_class('div')] | merge(settings.classes | default([])) | join(' ') %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    {% set custom_expand = settings.expand_icon.url | default('') %}
    {% set custom_collapse = settings.collapse_icon.url | default('') %}
    style="{% if custom_expand %}--aae-custom-expand: url('{{ custom_expand }}');{% endif %} {% if custom_collapse %}--aae-custom-collapse: url('{{ custom_collapse }}');{% endif %}"
    data-icon-pos="{{ settings.icon_position | default('right') }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {# Hidden container for children injection by Elementor #}
    <div class="aae-children-injector" style="display: none;">
        {{ children_placeholder | raw }}
    </div>

    {# Header Div - Clickable area #}
    {% set heading_tag = settings.title_html_tag | default('div') %}
    <{{ heading_tag }} class="aae-accordion-title-wrapper" style="margin: 0; padding: 0;">
        <button class="aae-accordion-header {{ base_styles.header | default('') }} {{ m.default_tag_class('button') }}"
            type="button"
            aria-expanded="{{ settings.is_active ? 'true' : 'false' }}"
            aria-controls="aae-accordion-content-{{ id }}"
            id="aae-accordion-header-{{ id }}"
            {# Accessible-name safety net. The visible title normally arrives as
               a child element that accordion.js moves into .aae-header-content,
               so the button names itself. But a header holding only an icon —
               or one whose title child was deleted — leaves a <button> with no
               name at all (a critical WCAG 4.1.2 failure), and it silently takes
               the content region's aria-labelledby down with it. accordion.js
               promotes this to aria-label only when the button really is empty,
               so a visible title is never overridden (WCAG 2.5.3). #}
            data-aae-fallback-label="{{ settings.item_title | default( 'Accordion Item' ) | e('html_attr') }}"
            style="display: flex; align-items: center; justify-content: space-between; width: 100%; background: transparent; border: none; cursor: pointer;">

            {# Header Div_Block (Title + Icon) injected here — the icon IS the toggle #}
            <div class="aae-header-content" style="display: flex; align-items: center; flex: 1; gap: 10px; min-width: 0;"></div>
        </button>
    </{{ heading_tag }}>

    {# Content Div #}
    <div id="aae-accordion-content-{{ id }}"
         class="aae-accordion-content-wrapper"
         role="region"
         aria-labelledby="aae-accordion-header-{{ id }}"
         style="overflow: hidden;">
        {# Content Div_Block (Text) - injected here by JS #}
        <div class="aae-accordion-content {{ base_styles.content | default('') }} e-con {{ m.default_tag_class('div') }}" style="display: flex; flex-direction: column; gap: 15px;"></div>
    </div>
</div>

{# Child distribution (moving the Header/Content Div_Blocks out of the hidden
   injector into their slots) is handled by the enqueued accordion.js bundle, so
   it runs in both the editor preview and the frontend. An inline <script> here
   would not run on the editor's client-side twig render — and it also prevented
   the editor's twig compiler from emitting the static .aae-accordion-header
   <button>, causing an editor/frontend design mismatch. #}