{#
  AAE Video Popup — parent template.

  Renders its children via children_placeholder: the Trigger, the Overlay
  (backdrop) and the Panel (the popup box, which owns every video source/
  playback/poster/controls prop) — all real, styleable atomic elements.
  The <style> block only carries what a base style can't: a flash-guard that
  keeps the Overlay/Panel out of flow + invisible until video-popup.js
  teleports and drives them (also keeps them from covering the editor
  canvas before the JS runs).
#}
{% set classes = ['aae-a-video-popup', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-close-on-overlay="{{ (settings.close_on_overlay is defined and not settings.close_on_overlay) ? 'false' : 'true' }}"
    data-close-on-esc="{{ (settings.close_on_esc is defined and not settings.close_on_esc) ? 'false' : 'true' }}"
    data-popup-anim="{{ settings.popup_animation | default('scale-reveal') }}"
    data-anim-duration="{{ settings.anim_duration | default(400) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    <style>
        [data-id="{{ id }}"] {
            vertical-align: top;
        }

        /* Flash-guard: keep the overlay/panel out of flow + invisible until
           video-popup.js positions/drives them. Matches by element-type attr
           (the editor strips custom classes off atomic children).
           visibility:hidden also stops them catching clicks, so neither ever
           covers the editor canvas. Once the JS teleports them to the body
           portal these selectors stop matching and the inline runtime
           styles take over. */
        [data-id="{{ id }}"] [data-e-type="e-aae-a-video-popup-overlay"],
        [data-id="{{ id }}"] [data-e-type="e-aae-a-video-popup-panel"] {
            position: fixed;
            inset: 0;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
    </style>

    {{ children_placeholder | raw }}
</div>
