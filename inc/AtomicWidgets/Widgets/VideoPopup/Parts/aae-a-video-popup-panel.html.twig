{#
  AAE Video Popup — Panel template.

  children_placeholder carries the three fixed children in order: Close,
  Player (mount + controls) and PlayBtn (overlay). The poster is NOT a
  child — plain `<img>` markup rendered right here from the `poster_image`
  setting, same as AAE Video's own wrapper twig, skipped entirely when
  `poster_enabled` is off. Every source/playback setting is emitted as
  data-aae-video-* attributes on THIS element — video-popup.js binds one
  frontend handler here and reads the Player child's mount/controls bar as
  descendants.

  Hook class is `aae-a-video-popup-source` (NOT `aae-a-video`, which AAE
  Video's own video.js already claims via a document-level delegated
  listener) — see this class's PHP docblock for why the two widgets never
  share a class name here.
#}
{% set wrapper_classes = ['aae-a-video-popup-panel', 'aae-a-video-popup-source', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set poster_src = (settings.poster_auto_fetch and settings.resolved_poster_url is defined and settings.resolved_poster_url is not empty) ? settings.resolved_poster_url : settings.poster_image.src %}
{# 'external' has no oEmbed-style thumbnail API, so when Auto-fetch Thumbnail
   is on and it comes up empty, fall back to the video file's own first
   frame — same mechanism as AAE Video's own wrapper twig. #}
{% set use_frame_poster = (settings.video_type | default('youtube')) == 'external' and settings.poster_auto_fetch and (settings.resolved_poster_url is not defined or settings.resolved_poster_url is empty) %}

<div
	class="{{ wrapper_classes }} {{ editor_classes | default('') }}"
	data-id="{{ id }}"
	data-element_type="{{ type }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default('') }}"
	data-aae-video-type="{{ settings.video_type | default('youtube') | e('html_attr') }}"
	data-aae-video-youtube-url="{{ settings.video_youtube_url | default('') | e('html_attr') }}"
	data-aae-video-hosted-url="{{ settings.video_hosted.url | default('') | e('html_attr') }}"
	data-aae-video-external-url="{{ settings.video_external_url | default('') | e('html_attr') }}"
	data-aae-video-vimeo-url="{{ settings.video_vimeo_url | default('') | e('html_attr') }}"
	data-aae-video-dailymotion-url="{{ settings.video_dailymotion_url | default('') | e('html_attr') }}"
	data-aae-video-videopress-url="{{ settings.video_videopress_url | default('') | e('html_attr') }}"
	data-aae-video-autoplay="{{ settings.autoplay ? 'true' : 'false' }}"
	data-aae-video-mute="{{ settings.mute ? 'true' : 'false' }}"
	data-aae-video-loop="{{ settings.loop ? 'true' : 'false' }}"
	data-aae-video-preload="{{ settings.preload | default('metadata') | e('html_attr') }}"
	data-aae-video-lazyload="{{ settings.lazyload ? 'true' : 'false' }}"
	data-aae-video-youtube-privacy="{{ settings.youtube_privacy ? 'true' : 'false' }}"
	data-aae-video-vimeo-dnt="{{ settings.vimeo_dnt ? 'true' : 'false' }}"
	data-aae-video-controls-enabled="{{ settings.controls_enabled ? 'true' : 'false' }}"
	data-aae-video-controls-autohide="{{ settings.controls_autohide ? 'true' : 'false' }}"
	{% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
	{% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
	{{ editor_attributes | default('') | raw }}
>
	{% if settings.poster_enabled %}
		{% if use_frame_poster %}<video class="aae-a-video-popup-poster aae-a-video-popup-poster-frame" muted playsinline preload="metadata" src="{{ settings.video_external_url | default('') | e('html_attr') }}"></video>
		{% else %}<img class="aae-a-video-popup-poster" src="{{ poster_src | e('full_url') }}" alt="" />{% endif %}
	{% endif %}
	{{ children_placeholder | raw }}
</div>
