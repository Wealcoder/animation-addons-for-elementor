{% import 'elementor/macros' as m %}
{#
	`aae-a-video-popup-playbtn` is video-popup.js's click-trigger hook,
	hardcoded here rather than seeded into the `classes` prop — same reason
	this widget's own Player part (aae-a-video-popup-player.html.twig)
	hardcodes its hooks.
#}
{%- set classes = ['aae-a-video-popup-playbtn', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') -%}
<button type="button" class="{{ classes }} {{ editor_classes | default('') }}"
	aria-label="{{ 'Play/Pause'|e('html_attr') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ children_placeholder | raw }}
</button>
