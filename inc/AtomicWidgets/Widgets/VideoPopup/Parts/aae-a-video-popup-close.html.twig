{#
  AAE Video Popup Close — renders <button class="aae-a-video-popup-close
  aae-video-popup-close" ...> directly. video-popup.js binds the close
  behaviour to the `.aae-video-popup-close` hook class (frontend only), so
  that class is baked into the template here — never seeded via the classes
  prop.

  Icon inlined from `settings.icon.html` (never an <img>) so Style-tab
  colour/hover reach it — same reasoning as the Trigger's icon.
#}
{% set classes = ['aae-a-video-popup-close', 'aae-video-popup-close', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set icon_svg = settings.icon.html | default('') %}

<button
    class="{{ classes }} {{ editor_classes | default('') }}"
    type="button"
    aria-label="{{ 'Close video' | e('html_attr') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
><span class="aae-a-video-popup-close-icon" aria-hidden="true" style="display:block;width:1em;height:1em;">{% if icon_svg is not empty %}{{ icon_svg | raw }}{% else %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>{% endif %}</span></button>
