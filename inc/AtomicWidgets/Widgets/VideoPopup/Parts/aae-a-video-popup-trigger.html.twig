{#
  AAE Video Popup Trigger — renders <button class="aae-a-video-popup-trigger
  aae-video-popup-trigger" ...> directly. video-popup.js binds the OPEN
  behaviour to the `.aae-video-popup-trigger` hook class (frontend only), so
  that class is baked into the template here — never seeded via the classes
  prop (see CLAUDE.md's "Never put a functional hook class in the classes
  prop").

  Two ways to render the rotator, chosen by `rotator_type`:
    - text: a curved SVG <textPath> rendered directly below, own font-size/
      radius controls — see class-aae-a-video-popup-trigger.php's docblock
      for why this couldn't become a native Paragraph child (tried twice).
    - image: the Rotator Image child (a real, locked e-image, always
      present in the tree via children_placeholder) is shown; hidden by the
      scoped selector below when text mode is active instead, so switching
      back and forth never loses the uploaded image.
  The Icon child (a real, locked e-svg) always renders on top of either.

  Duration/direction ride as CSS custom properties set HERE, on the button,
  rather than on the SVG/Image individually — custom properties inherit
  through the DOM, so video-popup.scss's single keyframe — reading
  `var(--aae-vp-rot-duration, ...)` off whichever rotator is currently
  spinning — gets the right value from this one ancestor declaration either
  way.

  The circular path's id is salted with this element's own `id` so multiple
  Trigger instances on one page never collide on the same `<path id>`.
#}
{% set classes = ['aae-a-video-popup-trigger', 'aae-video-popup-trigger', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set rotator_type = settings.rotator_type | default('image') %}
{% set duration = settings.rotation_duration | default(8) %}
{% set direction = (settings.rotation_direction | default('cw') == 'ccw') ? 'reverse' : 'normal' %}
{% set text_font_size = settings.rotator_text_font_size | default(10) %}
{% set text_radius = 50 - (settings.rotator_text_padding | default(8)) %}
{% set rotator_class = type ~ '-rotator' %}

<button
    class="{{ classes }} {{ editor_classes | default('') }}"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="{{ 'Play video' | e('html_attr') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    style="--aae-vp-rot-duration:{{ duration }}s;--aae-vp-rot-direction:{{ direction }};"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
>
    {% if rotator_type == 'text' %}
        <style>[data-id="{{ id }}"] .{{ rotator_class }}--image { display: none; }</style>
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="aae-a-video-popup-trigger-rotator--text {{ base_styles.rotator }}"
            aria-hidden="true"
            viewBox="0 0 100 100"
        ><defs><path id="aae-vp-circle-{{ id }}" d="M 50,50 m -{{ text_radius }},0 a {{ text_radius }},{{ text_radius }} 0 1,1 {{ text_radius * 2 }},0 a {{ text_radius }},{{ text_radius }} 0 1,1 -{{ text_radius * 2 }},0" /></defs><text style="font-size:{{ text_font_size }}px;"><textPath href="#aae-vp-circle-{{ id }}" startOffset="0%">{{ settings.rotator_text | default('') }}</textPath></text></svg>
    {% endif %}
    {{ children_placeholder | raw }}
</button>
