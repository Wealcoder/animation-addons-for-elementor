{% import 'elementor/macros' as m %}
{#
	`aae-a-video-popup-mount` / `-controls` are video-popup.js's hooks,
	hardcoded here rather than seeded into the `classes` prop (same reason
	the AAE Video widget's own Player part hardcodes its hooks). Deliberately
	namespaced `-popup-` and never reusing AAE Video's own `aae-a-video-*`
	class names: AAE Video's video.js installs a DOCUMENT-level delegated
	click listener matching those exact classes — reusing them here would let
	that unrelated widget's script fight this one for the same clicks.

	This part owns no source/playback settings — video-popup.js reads all of
	that from the PARENT Panel wrapper's data-aae-video-* attributes and
	treats the mount div + controls bar below purely as descendants to fill.

	`aae-a-video-popup-clickzone` sits between the media and the controls bar:
	a plain click listener can never see a click landing on a YouTube/Vimeo
	iframe (cross-origin, separate document), so this transparent layer is
	what actually receives the click and toggles play/pause.
#}
{%- set classes = ['aae-a-video-popup-mount', base_styles.base] | merge( settings.classes | default([]) ) | join(' ') -%}
<div class="{{ classes }} {{ editor_classes | default('') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>

	<div class="aae-a-video-popup-clickzone"></div>

	<div class="aae-a-video-popup-controls">
		<button type="button" class="aae-a-video-popup-btn aae-a-video-popup-btn--playpause" aria-label="{{ 'Play/Pause'|e('html_attr') }}">
			<svg class="aae-a-video-popup-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
			<svg class="aae-a-video-popup-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
		</button>

		<div class="aae-a-video-popup-progress" role="slider" tabindex="0" aria-label="{{ 'Seek'|e('html_attr') }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
			<div class="aae-a-video-popup-progress-fill"></div>
		</div>

		<span class="aae-a-video-popup-time"><span class="aae-a-video-popup-time-cur">0:00</span> / <span class="aae-a-video-popup-time-dur">0:00</span></span>

		<button type="button" class="aae-a-video-popup-btn aae-a-video-popup-btn--mute" aria-label="{{ 'Mute'|e('html_attr') }}">
			<svg class="aae-a-video-popup-icon-unmuted" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4.03v8.05A4.5 4.5 0 0 0 16.5 12z"/></svg>
			<svg class="aae-a-video-popup-icon-muted" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M16.5 12A4.5 4.5 0 0 0 14 8v2.18l2.45 2.45c.03-.2.05-.42.05-.63zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z"/></svg>
		</button>

		<button type="button" class="aae-a-video-popup-btn aae-a-video-popup-btn--fullscreen" aria-label="{{ 'Fullscreen'|e('html_attr') }}">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
		</button>
	</div>
</div>
