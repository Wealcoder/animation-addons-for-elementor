{% set position = settings.position | default('left') %}
{# The "Preview Open (Editor)" reveal is applied by offcanvas.js (editor
   reconciler), NOT here: the atomic Switch commits without re-rendering this
   Twig, so a {% if editor_open %} reveal would go stale on every live toggle. #}
{% set classes = ['aae-a-offcanvas', 'e-con', 'e-atomic-element', base_styles.base | default(''), 'position-' ~ position] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-position="{{ position }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    <style>
        [data-id="{{ id }}"] .aae-offcanvas-trigger {
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 0;
            color: inherit;
            padding: 0;
        }
        [data-id="{{ id }}"] .aae-offcanvas-trigger img,
        [data-id="{{ id }}"] .aae-offcanvas-trigger svg {
            display: block;
            width: 24px;
            height: 24px;
        }
        [data-id="{{ id }}"] .aae-offcanvas-overlay {
            display: none;
        }
        [data-id="{{ id }}"] .aae-offcanvas-shell {
            transform: translateX(-100%);
        }
    </style>

    {% set trigger_icon_url = settings.trigger_icon.url | default('') %}
    <button class="aae-offcanvas-trigger" type="button" aria-expanded="false" aria-label="Open panel">
        {% if trigger_icon_url is not empty %}
            <img src="{{ trigger_icon_url | e('html_attr') }}" alt="" aria-hidden="true">
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
        {% endif %}
    </button>

    <div class="aae-offcanvas-overlay" aria-hidden="true" style="position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0s 0.3s; z-index: 9998; pointer-events: none;"></div>

    <div class="aae-offcanvas-shell" style="position: fixed; z-index: 9999; overflow-y: auto; display: flex; flex-direction: column; width: 320px; max-width: 90vw; height: 100vh; visibility: hidden; pointer-events: none; transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);">
        {{ children_placeholder | raw }}
    </div>
</div>
