{#
  AAE Offcanvas — parent template.

  Renders: trigger button, scrim overlay, and the Panel child (via
  children_placeholder). The <style> block below is the ONLY CSS this widget
  emits, and it is deliberately tiny — it carries just what a base style can't:
    1. a structural reset for the plain-markup trigger (not an atomic element),
    2. a frontend flash-guard that hides the panel/overlay until the JS wires
       them (the JS teleports both to <body>), and
    3. an editor override that keeps the panel visible & in-flow so its content
       stays editable (the JS never runs in edit mode, so nothing teleports).
  Everything else (panel look, drawer geometry) lives in base styles / the JS.
#}
{% set position = settings.position | default('left') %}
{% set overlay = settings.overlay | default('dark') %}
{% set overlay_color = overlay == 'darker' ? 'rgba(0,0,0,0.75)' : (overlay == 'none' ? 'transparent' : 'rgba(0,0,0,0.5)') %}
{% set close_on_overlay = (settings.close_on_overlay is not defined or settings.close_on_overlay) ? 'true' : 'false' %}
{% set close_on_esc = (settings.close_on_esc is not defined or settings.close_on_esc) ? 'true' : 'false' %}
{% set editor_open = (settings.editor_open is defined and settings.editor_open) ? 'true' : 'false' %}
{% set trigger_icon_url = settings.trigger_icon.url | default('') %}
{% set classes = ['aae-a-offcanvas', 'e-con', 'e-atomic-element', base_styles.base | default(''), 'position-' ~ position] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-position="{{ position }}"
    data-overlay-color="{{ overlay_color | e('html_attr') }}"
    data-close-on-overlay="{{ close_on_overlay }}"
    data-close-on-esc="{{ close_on_esc }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    <style>
        /* 0. Root hugs the trigger — the closed offcanvas is just the bar icon,
              not a full-width tall container. Overrides Elementor's `.e-con`
              (display:flex + min-height) which would otherwise stretch it. */
        [data-id="{{ id }}"] {
            display: inline-block !important;
            min-height: 0 !important;
            vertical-align: top;
        }

        /* 1. Trigger reset — plain <button>, low specificity so Style edits win. */
        :where([data-id="{{ id }}"]) .aae-offcanvas-trigger {
            display: inline-flex; align-items: center; justify-content: center;
            cursor: pointer; background: transparent; border: 0; color: inherit; padding: 0;
        }
        :where([data-id="{{ id }}"]) .aae-offcanvas-trigger :is(img, svg) {
            display: block; width: 24px; height: 24px;
        }

        /* 2. Flash-guard — panel/overlay ALWAYS hidden by this rule (frontend
              needs it every load; the editor uses it as the closed state).
              Targeted by `data-element_type` (NOT class): the v4 editor strips
              custom classes off atomic children, but data-attrs survive.
              `!important` beats the panel's base `display:flex` (equal specificity,
              would win on order). Frontend: once the JS teleports the panel to
              <body> this selector stops matching and the JS inline styles win. */
        [data-id="{{ id }}"] [data-element_type="e-aae-a-offcanvas-panel"],
        [data-id="{{ id }}"] .aae-offcanvas-overlay { display: none !important; }

        {% if editor_open == 'true' %}
        /* 3. Editor OPEN — emitted ONLY when the "Open Panel (Editor)" switch is
              on (PHP decides, so it's deterministic; no runtime attr matching).
              Editor-scoped prefix means it can never affect the frontend even if
              the switch is left on. Higher specificity + `!important` overrides
              rule 2 and the base width, so the panel fills a comfortable editing
              area in-flow. */
        body.elementor-editor-active [data-id="{{ id }}"] [data-element_type="e-aae-a-offcanvas-panel"] {
            display: flex !important; position: static !important; transform: none !important;
            visibility: visible !important; max-width: none !important;
            height: auto !important; min-height: 160px; margin-top: 12px;
        }
        {% endif %}
    </style>

    <button class="aae-offcanvas-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="{{ 'Open panel' | e('html_attr') }}">
        {% if trigger_icon_url is not empty %}
            <img src="{{ trigger_icon_url | e('html_attr') }}" alt="" aria-hidden="true">
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
        {% endif %}
    </button>

    <div class="aae-offcanvas-overlay" aria-hidden="true"></div>

    {{ children_placeholder | raw }}
</div>
