{#
  AAE Offcanvas — parent template.

  Renders its children via children_placeholder: the Trigger, the Overlay
  (scrim — a real, styleable AAE_A_Offcanvas_Overlay element) and the Panel —
  all real atomic elements. The <style> block carries just two things a base
  style can't: (1) force the root to hug the trigger (override `.e-con`'s flex +
  min-height) so the closed offcanvas is only the toggle icon, and (2) a
  flash-guard that keeps the scrim out of flow / invisible until offcanvas.js
  teleports and drives it (also keeps it from covering the editor canvas).
  Everything else (look, drawer geometry) lives in the child base styles / JS.
#}
{% set position = settings.position | default('left') %}
{# The "Preview Open (Editor)" reveal is applied by offcanvas.js (editor
   reconciler), NOT here: the atomic Switch commits without re-rendering this
   Twig, so a {% if editor_open %} reveal would go stale on every live toggle. #}
{% set classes = ['aae-a-offcanvas', 'e-con', 'e-atomic-element', base_styles.base | default(''), 'position-' ~ position] | merge(settings.classes | default([])) | join(' ') | trim %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-position="{{ position }}"
    data-overlay-anim="{{ settings.overlay_animation | default('fade') }}"
    data-close-on-overlay="{{ (settings.close_on_overlay is defined and not settings.close_on_overlay) ? 'false' : 'true' }}"
    data-close-on-esc="{{ (settings.close_on_esc is defined and not settings.close_on_esc) ? 'false' : 'true' }}"
    data-enter-anim="{{ settings.open_animation | default('slide') }}"
    data-exit-anim="{{ settings.close_animation | default('reverse') }}"
    data-anim-duration="{{ settings.anim_duration | default(400) }}"
    data-ease="{{ settings.anim_easing | default('power2.out') }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    <style>
        /* Root hugs the trigger — the closed offcanvas is just the toggle icon,
           not a full-width tall container. Overrides Elementor's `.e-con`
           (display:flex + min-height) which would otherwise stretch it. */
        [data-id="{{ id }}"] {
            display: inline-block !important;
            min-height: 0 !important;
            vertical-align: top;
        }

        /* Flash-guard: keep the scrim out of flow + invisible until offcanvas.js
           positions/drives it. Matches by element-type attr (the editor strips
           custom classes off atomic children). visibility:hidden also stops it
           catching clicks, so it never covers the editor canvas. Once the JS
           teleports it to the body portal this selector stops matching and the
           inline runtime styles take over. */
        [data-id="{{ id }}"] [data-e-type="e-aae-a-offcanvas-overlay"] {
            position: fixed;
            inset: 0;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        /* Editor-only drop hint. `:has(> .elementor-element-edit-mode)` is the
           edit-mode test — that class exists only in the canvas. */
        [data-id="{{ id }}"] .aae-a-offcanvas-panel:has( > .elementor-element-edit-mode )::after {
            /* Plain literal, NOT e('html_attr'): a <style> block is not HTML —
               entities are never decoded there, so escaping would render the
               text as "Drop&#x20;any&#x20;content&#x20;here". */
            content: "Drop any content here";
            display: block;
            /* auto on the block axis centres it in the panel's free space. */
            margin: auto 0;
            padding: 28px 16px;
            border: 1px dashed rgba(0, 0, 0, .25);
            border-radius: 6px;
            font-size: 13px;
            line-height: 1.5;
            text-align: center;
            color: rgba(0, 0, 0, .5);
            pointer-events: none;
        }

        /* Two or more children means real content was added — hint has done its job. */
        [data-id="{{ id }}"] .aae-a-offcanvas-panel:has( > .elementor-element-edit-mode ~ .elementor-element-edit-mode )::after {
            content: none;
        }
    </style>

    {{ children_placeholder | raw }}
</div>
