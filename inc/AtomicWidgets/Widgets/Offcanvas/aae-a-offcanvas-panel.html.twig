{#
  AAE Offcanvas Panel — the sliding drawer surface AND the user drop-zone.

  The panel's look comes entirely from its base style (define_base_styles) so it
  is Style-panel overridable and survives the runtime teleport to <body> (base
  styles are global classes). The close button is a real, separately-styleable
  child element (AAE_A_Offcanvas_Close) seeded via define_default_children — it
  renders inside children_placeholder along with the user's content, so nothing
  close-related is hardcoded here any more.
#}
{% set classes = ['aae-a-offcanvas-panel', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') %}

<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'Offcanvas panel' | e('html_attr') }}"
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</div>
