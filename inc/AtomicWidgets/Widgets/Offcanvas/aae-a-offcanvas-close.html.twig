{% set classes = ['aae-a-offcanvas-close', 'aae-offcanvas-close', 'e-atomic-element', base_styles.base|default('')] | merge(settings.classes | default([])) | join(' ') %}
{% set icon_url = settings.icon.url | default('') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    role="button"
    tabindex="0"
    aria-label="Close panel"
    style="cursor:pointer;margin-bottom:16px;align-self:flex-end;flex:0 0 auto;"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {% if icon_url is not empty %}
        <img src="{{ icon_url | e('html_attr') }}" alt="" aria-hidden="true" style="width:100%;height:100%;display:block;">
    {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="100%" height="100%" aria-hidden="true" style="display:block;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    {% endif %}
</div>
