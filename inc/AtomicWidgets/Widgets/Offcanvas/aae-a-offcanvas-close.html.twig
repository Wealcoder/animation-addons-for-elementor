{#
  AAE Offcanvas Close — renders <button class="aae-a-offcanvas-close
  aae-offcanvas-close" ...> directly (no wrapper), mirroring the Form nav
  buttons. offcanvas.js binds the close behaviour to the `.aae-offcanvas-close`
  hook class inside the panel (frontend only), so that class is baked into the
  template here (NOT via the classes prop — a hook string in the classes prop
  would trip the Style panel's "missing class" warning).

  Icon is 1em so the button's Font Size (base style / Style tab) resizes it:
  an uploaded SVG (Icon control) if set, else a built-in X glyph.

  The uploaded icon is INLINED from `settings.icon.html` rather than rendered as
  an `<img>`, so `color` reaches it — see the trigger template's header for the
  full reasoning and the transformer references.
#}
{% set classes = ['aae-a-offcanvas-close', 'aae-offcanvas-close', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{# `.html` is null (JS) / '' (PHP) when nothing is uploaded or the fetch fails. #}
{% set icon_svg = settings.icon.html | default('') %}

<button
    class="{{ classes }} {{ editor_classes | default('') }}"
    type="button"
    aria-label="{{ 'Close panel' | e('html_attr') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
><span class="aae-a-offcanvas-close-icon" aria-hidden="true" style="display:block;width:1em;height:1em;">{% if icon_svg is not empty %}{{ icon_svg | raw }}{% else %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block;"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>{% endif %}</span></button>
