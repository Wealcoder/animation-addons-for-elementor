{#
  AAE Offcanvas Overlay — the scrim/backdrop. Renders a bare <div> carrying the
  `.aae-offcanvas-overlay` hook class (baked here, NOT via the classes prop, so
  it never trips the Style panel's "missing class" warning). Its colour comes
  from its own base style / Style-tab Background. Position, size, visibility and
  the reveal animation are applied at runtime by offcanvas.js; a flash-guard in
  the PARENT template keeps it hidden (out of flow) until then, both on the
  frontend (pre-JS) and in the editor.
#}
{% set classes = ['aae-a-offcanvas-overlay', 'aae-offcanvas-overlay', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}

<div
    class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    aria-hidden="true"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}></div>
