{% set classes = ['aae-a-offcanvas-trigger', 'aae-offcanvas-trigger', 'e-atomic-element', base_styles.base|default('')] | merge(settings.classes | default([])) | join(' ') %}
{% set icon_url = settings.icon.url | default('') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Open panel"
    style="cursor:pointer;"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {% if icon_url is not empty %}
        <img src="{{ icon_url | e('html_attr') }}" alt="" aria-hidden="true" style="width:100%;height:100%;display:block;">
    {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="100%" height="100%" aria-hidden="true" style="display:block;"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
    {% endif %}
</div>
