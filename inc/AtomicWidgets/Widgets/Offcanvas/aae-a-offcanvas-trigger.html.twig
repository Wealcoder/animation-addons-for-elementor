{#
  AAE Offcanvas Trigger — renders <button class="aae-a-offcanvas-trigger
  aae-offcanvas-trigger" ...> directly (no wrapper), mirroring the close button.
  offcanvas.js binds the OPEN behaviour to the `.aae-offcanvas-trigger` hook
  class inside the offcanvas root (frontend only), so that class is baked into
  the template here (NOT via the classes prop — a hook string in the classes
  prop would trip the Style panel's "missing class" warning).

  Icon is 1em so the button's Font Size (base style / Style tab) resizes it:
  an uploaded SVG (Icon control) if set, else a built-in hamburger glyph.
#}
{% set classes = ['aae-a-offcanvas-trigger', 'aae-offcanvas-trigger', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') | trim %}
{% set icon_url = settings.icon.url | default('') %}

<button
    class="{{ classes }} {{ editor_classes | default('') }}"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="{{ 'Open panel' | e('html_attr') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
><span class="aae-a-offcanvas-trigger-icon" aria-hidden="true">{% if icon_url is not empty %}<img src="{{ icon_url | e('html_attr') }}" alt="" style="width:1em;height:1em;display:block;">{% else %}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" style="display:block;"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>{% endif %}</span></button>
