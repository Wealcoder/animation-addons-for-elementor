{% set btn_classes = ['aae-a-search-form-btn', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') %}

<button class="{{ btn_classes }} {{ editor_classes | default('') }}"
        type="submit"
        aria-label="Search"
        data-id="{{ id }}"
        data-element_type="{{ type }}"
        data-e-type="{{ type }}"
        data-interaction-id="{{ interaction_id | default('') }}"
        {% if settings.attributes is defined and settings.attributes is not empty %}
            {{ settings.attributes | raw }}
        {% endif %}
        {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</button>
