{% import 'elementor/macros' as m %}
{#
	`aae-a-video-playbtn` is video.js's click-trigger hook, hardcoded here
	rather than seeded into the `classes` prop — same reason
	aae-a-progressbar-fill.html.twig and this widget's own Player part
	(aae-a-video-player.html.twig) hardcode their hooks: a class seeded via
	`classes` on a panel-tracked element shows up as a removable chip, and
	Elementor's "Some classes are missing" alert can strip it right back off.
#}
{%- set classes = ['aae-a-video-playbtn', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') -%}
<button type="button" class="{{ classes }} {{ editor_classes | default('') }}"
	aria-label="{{ 'Play/Pause'|e('html_attr') }}"
	{{- m.render_data_attributes(id, type, interaction_id | default('')) }}
	{{- m.render_custom_attributes(settings, editor_attributes) }}>
	{{ children_placeholder | raw }}
</button>
