{% set btn_classes = ['aae-a-btn', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) %}

{% if settings.btn_target == '_blank' %}
    {% set rel_attr = 'noopener' ~ (settings.btn_nofollow ? ' nofollow' : '') %}
{% elseif settings.btn_nofollow %}
    {% set rel_attr = 'nofollow' %}
{% else %}
    {% set rel_attr = '' %}
{% endif %}

<a class="{{ btn_classes | join(' ') }} {{ editor_classes | default('') }}"
   {% if settings.btn_url is defined and settings.btn_url is not empty and settings.btn_url != '#' %}
       href="{{ settings.btn_url | e('html_attr') }}"
   {% else %}
       tabindex="0" role="button"
   {% endif %}
   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
   data-id="{{ id }}"
   data-element_type="{{ type }}"
   data-e-type="{{ type }}"
   data-interaction-id="{{ interaction_id | default('') }}"
   {% if settings._cssid is defined and settings._cssid is not empty %}
       id="{{ settings._cssid | e('html_attr') }}"
   {% endif %}
   {% if settings.attributes is defined and settings.attributes is not empty %}
       {{ settings.attributes | raw }}
   {% endif %}
   {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</a>

{#
    No external CSS for this widget — just enough to make the default
    label + icon children look like a button out of the box.

    <style>

        [data-id="{{ id }}"].aae-a-btn .e-svg-base {
            width: 1em;
            height: 1em;
        }

        [data-id="{{ id }}"].aae-a-btn svg {
            width: 100%;
            height: 100%;
            fill: currentColor;
        }
        [data-id="{{ id }}"].aae-a-btn .e-paragraph-base {
            margin: 0;
        }
    </style>

#}

