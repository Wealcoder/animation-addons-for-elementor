{% import 'elementor/macros' as m %}
{# `m.default_tag_class('a')` emits `e-default-a` — the hook Elementor's Design
   System > Defaults writes against (`.elementor .e-default-a { … }`). Core's
   Button puts it on the root the same way; without it this widget is invisible
   to the Defaults panel while a core Button beside it obeys.

   The tag is the LITERAL 'a', not a variable, because this template always
   renders an <a>: with no link it keeps the element and switches to
   `tabindex="0" role="button"` rather than becoming a <button>. The class has
   to describe the element actually rendered, so `a` is right even in that case.

   Cascade order needs no help — `.elementor .e-default-a` and
   `.elementor .e-aae-a-btn-base` are both (0,2,0) and the defaults sheet loads
   after the base sheet, so a default beats our base style while a Style-tab
   value, written to the per-document sheet after both, still beats the default.
   Per property, so anything set by hand is kept. #}
{% set btn_classes = ['aae-a-btn', 'e-con', 'e-atomic-element', base_styles.base, m.default_tag_class('a')]
    | merge(settings.aae_btn_text_flip ? ['aae-btn-txtflip'] : [])
    | merge(settings.aae_btn_border_divide ? ['aae-btn-borderdivide'] : [])
    | merge(settings.aae_btn_mask ? ['aae-btn-mask'] : [])
    | merge(settings.aae_btn_divide ? ['aae-btn-divide'] : [])
    | merge(settings.aae_btn_cross ? ['aae-btn-cross'] : [])
    | merge(settings.aae_btn_outlinepill ? ['aae-btn-outlinepill'] : [])
    | merge(settings.aae_btn_slidefill ? ['aae-btn-slidefill'] : [])
    | merge(settings.aae_btn_underline ? ['aae-btn-underline'] : [])
    | merge(settings.aae_btn_hover_effect ? ['aae-btn-' ~ settings.aae_btn_hover_style] : [])
    | merge(settings.classes | default([])) %}

{% set link_href = settings.link.href | default('') %}
{% set link_target = settings.link.target | default('_self') %}

{% if link_target == '_blank' %}
    {% set rel_attr = 'noopener' ~ (settings.btn_nofollow ? ' nofollow' : '') %}
{% elseif settings.btn_nofollow %}
    {% set rel_attr = 'nofollow' %}
{% else %}
    {% set rel_attr = '' %}
{% endif %}

<a class="{{ btn_classes | join(' ') }} {{ editor_classes | default('') }}"
   {% if link_href is not empty and link_href != '#' %}
       href="{{ link_href | e('html_attr') }}"
   {% else %}
       tabindex="0" role="button"
   {% endif %}
   {% if link_target == '_blank' %}target="_blank"{% endif %}
   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
   data-id="{{ id }}"
   data-element_type="{{ type }}"
   data-e-type="{{ type }}"
   data-interaction-id="{{ interaction_id | default('') }}"
   {% if settings._cssid is defined and settings._cssid is not empty %}
       id="{{ settings._cssid | e('html_attr') }}"
   {% endif %}
   {% if settings.attributes is defined and settings.attributes is not empty %}
       {{ settings.attributes | raw }}
   {% endif %}
   {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</a>

