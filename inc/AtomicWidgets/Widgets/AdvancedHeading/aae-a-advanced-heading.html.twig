{#
  AAE Advanced Heading — renders the rich-text `content` inside the chosen tag.

  `content` is an html-v3 prop; Html_V3_Transformer has already flattened it to
  the inner string by the time this runs, so `settings.content` is plain HTML.
  It was sanitised on save by wp_kses (no attributes survive except a[href|target]),
  and `striptags` here is the second belt — mirroring core's own heading twig, so
  a value written by anything other than the panel still cannot inject a tag.
  Keep this whitelist in sync with atomic-heading.html.twig.
#}
{% set allowed_inline = '<b><strong><sup><sub><s><em><i><u><a><del><span><br>' %}
{% set allowed_tags = ['h1','h2','h3','h4','h5','h6','div','p','span'] %}
{% set tag = settings.ah_tag | default('h2') %}
{% if tag not in allowed_tags %}{% set tag = 'h2' %}{% endif %}

{% set classes = [
        'aae-a-advanced-heading',
        'e-atomic-element'
    ] | merge(settings.classes | default([])) | join(' ') | trim %}

<{{ tag | e('html_tag') }}
    class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default(id) }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}id="{{ settings._cssid | e('html_attr') }}"{% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}{{ settings.attributes | raw }}{% endif %}
    {{ editor_attributes | default('') | raw }}
>{{ settings.content | default('') | striptags(allowed_inline) | raw }}</{{ tag | e('html_tag') }}>
