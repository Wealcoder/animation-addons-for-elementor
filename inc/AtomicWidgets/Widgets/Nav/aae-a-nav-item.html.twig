{% import 'elementor/macros' as m %}
{% set classes = ['aae-a-nav-item', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') %}
{% set has_dropdown = settings.has_dropdown ? 'true' : 'false' %}
{% set trigger = settings.trigger | default('click') %}
{% set dropdown_anim = settings.dropdown_animation | default('gsap') %}
{% set has_link = settings.link is defined and settings.link.href is defined and settings.link.href is not empty %}

{# Rendered as <div>, NOT <li>: a nav-item can be nested inside another
   nav-item's dropdown flexbox (a <div>) for multi-level menus. A <div> does
   not bound the browser's "list-item scope", so a nested <li> would auto-close
   its ancestor <li> and the parser would rip the nested tree apart. Using
   <div> throughout (nav + items) keeps deep nesting intact. #}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    role="menuitem"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-has-dropdown="{{ has_dropdown }}"
    data-trigger="{{ trigger }}"
    data-dropdown-anim="{{ dropdown_anim }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {% if has_link %}
        <{{ settings.link.tag | default('a') | e('html_tag') }} class="aae-a-nav-item-label" {{ m.render_link_attributes(settings.link) }}>
            {{ settings.text | striptags('<b><strong><sup><sub><s><em><u><span><br>') | raw }}
        </{{ settings.link.tag | default('a') | e('html_tag') }}>
    {% else %}
        <span class="aae-a-nav-item-label">
            {{ settings.text | striptags('<b><strong><sup><sub><s><em><u><span><br>') | raw }}
        </span>
    {% endif %}

    {# Dropdown container (typically a Flexbox) renders directly — the user styles it via its own Style tab. #}
    {{ children_placeholder | raw }}
</div>
