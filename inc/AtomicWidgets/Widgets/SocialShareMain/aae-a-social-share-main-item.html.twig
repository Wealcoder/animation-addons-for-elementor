{% set vendor = settings.vendor | default('facebook') %}
{% set classes = ['aae-a-social-share-main-item', 'e-con', 'e-atomic-element', 'aae-a-social-share-main-item--' ~ vendor, base_styles.base|default('')] | merge(settings.classes | default([])) | join(' ') %}

<li class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    data-aae-vendor="{{ vendor | e('html_attr') }}"
    data-aae-share-url="{{ settings.share_url | default('#') | e('html_attr') }}"
    data-aae-share-count="{{ settings.share_count | default(0) | e('html_attr') }}"
    role="listitem"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</li>
