{% set classes = ['aae-a-loop-numbers', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {# In the editor the PHP context isn't available (client-side render), so
       fall back to a representative 1-5 so the numbers are visible + styleable. #}
    {% for p in page_items | default([1, 2, 3, 4, 5]) %}
        {% if p == '...' %}
            <span class="aae-a-loop-num aae-a-loop-num-gap">&hellip;</span>
        {% else %}
            <a href="#" class="aae-a-loop-num{{ p == (current_page | default(1)) ? ' is-active' : '' }}" data-aae-page="{{ p }}">{{ p }}</a>
        {% endif %}
    {% endfor %}
</div>
