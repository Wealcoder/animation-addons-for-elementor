{% import 'elementor/macros' as m %}
{# `m.default_tag_class(…)` emits the `e-default-<tag>` hook for Elementor's
   Design System > Defaults. Rationale and the tag-choice rules for this whole
   group live in aae-a-loop-grid.html.twig. #}
{% set classes = ['aae-a-loop-numbers', 'e-atomic-element', base_styles.base, m.default_tag_class('div')] | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | default('') | raw }}
</div>
