{% import 'elementor/macros' as m %}
{% set classes = settings.classes | merge([ base_styles.base, 'aae-a-counter-number' ]) | join(' ') %}
<span class="{{ classes }}"
	style="font-variant-numeric: tabular-nums;"
	data-id="{{ id }}"
	data-e-type="{{ type }}"
	data-interaction-id="{{ interaction_id | default('') }}"
	data-from="{{ settings.startNumber | default(0) }}"
	data-to="{{ settings.endNumber | default(100) }}"
	data-duration="{{ settings.duration | default(2000) }}"
	{{- m.render_custom_attributes(settings) }}
>{{ settings.startNumber | default(0) }}</span>
