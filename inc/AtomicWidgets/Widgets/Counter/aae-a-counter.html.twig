{% set classes = ['e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-counter-from="{{ settings.start_number | default(0) }}"
    data-counter-duration="{{ settings.duration | default(2000) }}"
    {% if settings.count_easing is defined and settings.count_easing is not empty and settings.count_easing != 'ease-out' %}data-counter-easing="{{ settings.count_easing | e('html_attr') }}"{% endif %}
    {% if settings.count_replay is defined and settings.count_replay == 'replay' %}data-counter-replay="1"{% endif %}
    {% if settings.count_separator is defined and settings.count_separator in ['on', 'off'] %}data-counter-group="{{ settings.count_separator }}"{% endif %}
    {% if settings.count_decimals is defined and settings.count_decimals in ['0', '1', '2', '3'] %}data-counter-decimals="{{ settings.count_decimals }}"{% endif %}
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</div>
