{% import 'elementor/macros' as m %}
{# `m.default_tag_class(…)` emits the `e-default-<tag>` hook for Elementor's
   Design System > Defaults. Rationale and the tag-choice rules for this whole
   group live in aae-a-slider.html.twig. #}
{% set classes = ['aae-slider-track', 'e-con', 'e-atomic-element', m.default_tag_class('div')] | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    style="display: flex; gap: var(--aae-slide-gap); width: 100%; touch-action: pan-y; perspective: var(--aae-perspective); transform-style: preserve-3d; overflow: visible;"
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</div>
