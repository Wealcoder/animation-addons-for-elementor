{% set classes = ['js-aae-percentage', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
<span class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    {{ editor_attributes | default('') | raw }}>0%</span>
