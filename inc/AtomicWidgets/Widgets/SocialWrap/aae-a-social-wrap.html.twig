{% set wrap_classes = ['aae-a-social-wrap', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) %}

<div class="{{ wrap_classes | join(' ') }} {{ editor_classes | default('') }}"
     data-id="{{ id }}"
     data-element_type="{{ type }}"
     data-e-type="{{ type }}"
     data-interaction-id="{{ interaction_id | default('') }}"
     role="list"
     {% if settings._cssid is defined and settings._cssid is not empty %}
         id="{{ settings._cssid | e('html_attr') }}"
     {% endif %}
     {% if settings.attributes is defined and settings.attributes is not empty %}
         {{ settings.attributes | raw }}
     {% endif %}
     {{ editor_attributes | default('') | raw }}>

    {#
        Low-opinion defaults ONLY — sized icon + tight label line-height so
        a freshly dropped item doesn't render Atomic_Svg's giant 65x65
        default. Wrapped in `:where()` (0 specificity) so any per-item
        Style panel override, or a template's own local/global class,
        always wins.
    #}
    <style>
        :where([data-id="{{ id }}"] .aae-a-social-wrap-item-icon) {
            width: 22px;
            height: 22px;
            font-size: 22px;
            flex-shrink: 0;
            fill: currentColor;
        }
        :where([data-id="{{ id }}"] .aae-a-social-wrap-item-label) {
            line-height: 1;
            font-size: 14px;
        }
    </style>

    {{ children_placeholder | raw }}
</div>
