{% set classes = ['aae-a-post-pagination', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
{% set extra = '' %}
{% if pn_no_prev %}{% set extra = extra ~ ' aae-pp-no-prev' %}{% endif %}
{% if pn_no_next %}{% set extra = extra ~ ' aae-pp-no-next' %}{% endif %}
<div class="{{ classes }}{{ extra }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    data-aae-post-pagination="1"
    data-aae-pp-mode="{{ pn_mode | default('inline') }}"
    data-aae-pp-config="{{ pn_config | default('{}') | e('html_attr') }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</div>
