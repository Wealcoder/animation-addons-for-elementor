{% set classes = ['aae-a-post-pagination-item', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
{% set available = nav_available | default(false) %}
<a class="{{ classes }}{% if not available %} aae-pp-disabled{% endif %} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    {% if nav_role is defined %}data-aae-nav="{{ nav_role }}"{% endif %}
    data-aae-url="{{ nav_url | default('') }}"
    {% if available %}
        href="{{ nav_url }}"
        aria-label="{{ nav_title | default('') }}"
    {% else %}
        aria-disabled="true"
        tabindex="-1"
    {% endif %}
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {{ children_placeholder | raw }}
</a>
