{% set classes = ['aae-a-draw-svg', 'e-atomic-element', base_styles.base|default('')] | merge(settings.classes | default([])) | join(' ') %}
<div class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id }}"
    data-scroll_trigger="{{ settings.scroll_trigger ? 'yes' : 'no' }}"
    data-method="{{ settings.animation_method | default('from') | e('html_attr') }}"
    data-from="{{ settings.animation_from | default('0%') | e('html_attr') }}"
    data-to="{{ settings.animation_to | default('100%') | e('html_attr') }}"
    data-duration="{{ settings.aae_duration | default(2) }}"
    data-delay="{{ settings.aae_delay | default(0.5) }}"
    data-repeat="{{ settings.aae_repeat_count | default(-1) }}"
    data-repeatDelay="{{ settings.repeatDelay | default(0.5) }}"
    data-ease="{{ settings.aae_ease | default('sine.inOut') | e('html_attr') }}"
    data-scrub="{{ settings.scrub | default('false') | e('html_attr') }}"
    data-scrub_number="{{ settings.scrub_number | default(1) }}"
    data-yoyo="{{ settings.enable_yoyo ? 'yes' : 'no' }}"
    data-scrolltriggerStart="{{ settings.trigger_start | default('top 75%') | e('html_attr') }}"
    data-scrolltriggerEnd="{{ settings.trigger_end | default('bottom 0%') | e('html_attr') }}"
    data-linkable="{{ settings.aae_svg_linkable ? 'yes' : 'no' }}"
    data-link-url="{{ settings.link_url | default('') | e('html_attr') }}"
    data-link-external="{{ settings.link_external ? 'yes' : 'no' }}"
    data-link-nofollow="{{ settings.link_nofollow ? 'yes' : 'no' }}"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>
    {#
       Constrain the inline SVG to the element box on BOTH editor and frontend.
       A pasted SVG often carries a hardcoded width/height (e.g. 800px) which
       overflows on the frontend — the editor canvas happens to reset it, the
       frontend does not. max-width:100% + height:auto keeps aspect ratio and
       lets the Style-panel width/height on the root drive the real size.
    #}
    <style>[data-id="{{ id }}"] svg { max-width: 100%; height: auto; display: block; }</style>
    {% if settings.stroke_color is defined and settings.stroke_color is not empty %}
        <style>[data-id="{{ id }}"] svg path { stroke: {{ settings.stroke_color }}; }</style>
    {% endif %}
    {#
       Must render in BOTH the server render (frontend) and the editor's client
       render. `svg_markup` is computed in get_atomic_settings() (server only —
       file_get_contents for images), so it's EMPTY in the editor. Fall back to the
       raw props (svg_code / svg_image.url), which ARE available client-side:
         - frontend       → svg_markup (inlined SVG, DrawSVG-animatable)
         - editor + code   → svg_code inline (also animatable)
         - editor + image  → <img> preview (visible; animates on frontend)
    #}
    {% set svg_type = settings.svg_type | default('svg_code') %}
    {% set svg_markup = settings.svg_markup | default('') %}
    {% set img = settings.svg_image | default(null) %}
    {% set img_url = '' %}
    {% if img is not null and img.url is defined %}
        {% set img_url = img.url.value is defined ? img.url.value : img.url %}
    {% endif %}
    {% if svg_markup is not empty %}
        {{ svg_markup | raw }}
    {% elseif svg_type == 'svg_code' %}
        {{ settings.svg_code | default('') | raw }}
    {% elseif img_url is not empty %}
        <img src="{{ img_url | e('html_attr') }}" alt="" style="max-width:100%;display:block;">
    {% endif %}
</div>
