{% set classes = ['aae-a-site-logo', 'e-con', 'e-atomic-element', base_styles.base | default('')] | merge(settings.classes | default([])) | join(' ') %}

{% if settings.sl_link_target == '_blank' %}
    {% set rel_attr = 'noopener' ~ (settings.sl_link_nofollow ? ' nofollow' : '') %}
{% elseif settings.sl_link_nofollow %}
    {% set rel_attr = 'nofollow' %}
{% else %}
    {% set rel_attr = '' %}
{% endif %}

{% set has_href = settings.sl_resolved_href is defined and settings.sl_resolved_href is not empty %}

<a class="{{ classes }} {{ editor_classes | default('') }}"
   {% if has_href %}href="{{ settings.sl_resolved_href | e('html_attr') }}"{% endif %}
   {% if not has_href %}role="presentation"{% endif %}
   {% if settings.sl_link_target == '_blank' %}target="_blank"{% endif %}
   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
   aria-label="{{ settings.sl_site_logo_alt | default('Site Logo') | e }}"
   data-id="{{ id }}"
   data-element_type="{{ type }}"
   data-e-type="{{ type }}"
   data-interaction-id="{{ interaction_id | default('') }}"
   {% if settings._cssid is defined and settings._cssid is not empty %}
       id="{{ settings._cssid | e('html_attr') }}"
   {% endif %}
   {% if settings.attributes is defined and settings.attributes is not empty %}
       {{ settings.attributes | raw }}
   {% endif %}
   {{ editor_attributes | default('') | raw }}>

    {#
      Stylesheet lives here rather than in an enqueued file: it is ~140 bytes,
      so a separate HTTP request costs more than the bytes it saves. This
      template is the single source of truth — there is deliberately no
      site-logo.scss, and no `style_handle` in class-atomic.php's registry
      entry for this widget.

      It MUST sit inside the <a>, not before it. The editor renders this same
      twig client-side (Has_Template::get_initial_config() ships the file to
      the browser) and treats the template's first element as the element root
      — a leading <style> makes the editor adopt that instead of the anchor and
      the widget disappears from the preview entirely. Verified, not theorised.

      `sl_print_css` is set by get_atomic_settings() and is true for only the
      FIRST Site Logo rendered per request, so a header + footer pair emits one
      <style>, not two. It is UNDEFINED in the editor, which never sees
      PHP-injected settings — hence `is not defined or`, without which the
      widget would render unstyled in the preview.
    #}
    {% if settings.sl_print_css is not defined or settings.sl_print_css %}
        <style>.aae-a-site-logo:focus{outline:none}.aae-a-site-logo img{display:block;max-width:100%;height:auto}</style>
    {% endif %}

    {% if settings.sl_logo_to == 'custom' %}
        {# Custom mode: render the native e-image child — user controls the image via its own panel. #}
        {{ children_placeholder | raw }}
    {% else %}
        {# Site Logo mode: always render the current WordPress custom logo, resolved fresh on every request. #}
        {% if settings.sl_site_logo_url is defined and settings.sl_site_logo_url is not empty %}
            <img class="aae-site-logo-img"
                 src="{{ settings.sl_site_logo_url | e('html_attr') }}"
                 alt="{{ settings.sl_site_logo_alt | default('') | e }}" />
        {% endif %}
    {% endif %}

</a>
