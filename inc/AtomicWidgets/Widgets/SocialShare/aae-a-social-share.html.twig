{% set classes = ['aae-a-social-share', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) | join(' ') %}
{% set preset = settings.preset | default('outlined') %}

<ul class="{{ classes }} {{ editor_classes | default('') }}"
    data-id="{{ id }}"
    data-element_type="{{ type }}"
    data-e-type="{{ type }}"
    data-interaction-id="{{ interaction_id | default('') }}"
    data-preset="{{ preset | e('html_attr') }}"
    data-show-title="{{ settings.show_title ? 'true' : 'false' }}"
    data-show-count="{{ settings.show_count ? 'true' : 'false' }}"
    role="list"
    {% if settings._cssid is defined and settings._cssid is not empty %}
        id="{{ settings._cssid | e('html_attr') }}"
    {% endif %}
    {% if settings.attributes is defined and settings.attributes is not empty %}
        {{ settings.attributes | raw }}
    {% endif %}
    {{ editor_attributes | default('') | raw }}>

    {#
        Preset CSS bank — TWO specificity tiers per preset:

        1. STRUCTURAL rules → `[data-id][data-preset] .child`     → (0,3,0)
           Layout/positioning the preset NEEDS to function: padding,
           item border, icon size where it's required by the variant.
           Trade-off: user's Style panel (0,1,0) cannot override these.

        2. VISUAL rules     → `:where([data-id][data-preset] .child)` → (0,0,0)
           Colours, fonts, sizes, shadows. Wrapped in `:where()` so the
           specificity drops to 0 and Elementor's Style-panel local-style
           rules at (0,1,0) ALWAYS win.
    #}
    <style>
        /* Show / hide title + count globally based on parent toggles. */
        [data-id="{{ id }}"][data-show-title="false"] .aae-a-social-share-item-title {
            display: none;
        }
        [data-id="{{ id }}"][data-show-count="false"] .aae-a-social-share-item__count {
            display: none;
        }

        /* SVG default size — beats Atomic_Svg's 65×65 base. Wrapped in
           `:where()` so the user can still resize from the SVG element's
           Style panel. */
        :where([data-id="{{ id }}"] .aae-a-social-share-item-icon) {
            width: 22px;
            height: 22px;
            font-size: 22px;
            flex-shrink: 0;
            fill: currentColor;
        }
        :where([data-id="{{ id }}"] .aae-a-social-share-item-title) {
            line-height: 1;
        }

        /* Count badge — appended by frontend-handlers JS; ordered LAST in
           the item's flex row regardless of DOM position. */
        [data-id="{{ id }}"] .aae-a-social-share-item__count {
            order: 99;
        }
        :where([data-id="{{ id }}"] .aae-a-social-share-item__count) {
            font-size: 0.78em;
            padding: 2px 6px;
            border-radius: 999px;
            background: rgba(0, 0, 0, 0.08);
            min-width: 1.5em;
            text-align: center;
            line-height: 1;
        }

        /* ═════════════════════════════════════════════════════
           PRESET: minimal — flat inline icons, no chrome
           ═════════════════════════════════════════════════════ */
        :where([data-id="{{ id }}"][data-preset="minimal"] .aae-a-social-share-item) {
            padding: 4px 6px;
            color: #1a1a1a;
            background: transparent;
            transition: color 0.2s ease;
        }
        :where([data-id="{{ id }}"][data-preset="minimal"] .aae-a-social-share-item:hover) {
            color: #6d28d9;
        }
        :where([data-id="{{ id }}"][data-preset="minimal"] .aae-a-social-share-item__count) {
            background: transparent;
            padding: 0;
        }

        /* ═════════════════════════════════════════════════════
           PRESET: outlined — bordered chip (default)
           ═════════════════════════════════════════════════════ */
        :where([data-id="{{ id }}"][data-preset="outlined"] .aae-a-social-share-item) {
            padding: 8px 14px;
            border: 1.5px solid #1a1a1a;
            border-radius: 6px;
            color: #1a1a1a;
            background: transparent;
            transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
        }
        :where([data-id="{{ id }}"][data-preset="outlined"] .aae-a-social-share-item:hover) {
            background: #1a1a1a;
            color: #fff;
            border-color: #1a1a1a;
        }

        /* ═════════════════════════════════════════════════════
           PRESET: solid — brand-coloured pill buttons
           Per-vendor brand colour via `.aae-a-social-share-item--<vendor>`
           class that the item Twig emits.
           ═════════════════════════════════════════════════════ */
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item) {
            padding: 10px 18px;
            border-radius: 999px;
            color: #fff;
            background: #1a1a1a;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.10);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item:hover) {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
            filter: brightness(1.08);
        }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item__count) {
            background: rgba(255, 255, 255, 0.22);
            color: #fff;
        }

        /* Brand colours — solid preset only */
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--facebook)  { background: #1877f2; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--twitter)   { background: #000000; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--linkedin)  { background: #0a66c2; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--instagram) { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--pinterest) { background: #e60023; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--tumblr)    { background: #36465d; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--blogger)   { background: #ff8000; }
        :where([data-id="{{ id }}"][data-preset="solid"] .aae-a-social-share-item--reddit)    { background: #ff4500; }
    </style>

    {{ children_placeholder | raw }}
</ul>
