{% set item_classes = ['aae-a-social-share-item', 'e-con', 'e-atomic-element', base_styles.base] | merge(settings.classes | default([])) %}
{% if settings.hover_pulse is defined and settings.hover_pulse %}
    {% set item_classes = item_classes | merge(['aae-social-pulse']) %}
{% endif %}

{% if settings.btn_target == '_blank' %}
    {% set rel_attr = 'noopener' ~ (settings.btn_nofollow ? ' nofollow' : '') %}
{% elseif settings.btn_nofollow %}
    {% set rel_attr = 'nofollow' %}
{% else %}
    {% set rel_attr = '' %}
{% endif %}

{% set fallback_href = (settings.share_vendor is defined and settings.share_vendor is not empty) ? settings.share_link : settings.btn_url %}
{% set href_value = resolved_href is defined ? resolved_href : fallback_href %}

<a class="{{ item_classes | join(' ') }} {{ editor_classes | default('') }}"
   {% if href_value is defined and href_value is not empty and href_value != '#' %}
       href="{{ href_value | e('html_attr') }}"
   {% else %}
       tabindex="0"
   {% endif %}
   {% if settings.btn_target == '_blank' %}target="_blank"{% endif %}
   {% if rel_attr is not empty %}rel="{{ rel_attr }}"{% endif %}
   data-id="{{ id }}"
   data-element_type="{{ type }}"
   data-e-type="{{ type }}"
   data-interaction-id="{{ interaction_id | default('') }}"
   role="listitem"
   {% if settings._cssid is defined and settings._cssid is not empty %}
       id="{{ settings._cssid | e('html_attr') }}"
   {% endif %}
   {% if settings.attributes is defined and settings.attributes is not empty %}
       {{ settings.attributes | raw }}
   {% endif %}
   {{ editor_attributes | default('') | raw }}>

    {{ children_placeholder | raw }}
</a>
