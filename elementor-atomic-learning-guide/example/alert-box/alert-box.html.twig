{# Twig template for Alert Box Atomic Widget #}

{% if settings.content is not empty or settings.title is not empty %}

	{# Define allowed HTML tags for the message content #}
	{% set allowed_tags = '<b><strong><sup><sub><s><em><i><u><a><del><span><br>' %}

	{# Build the CSS classes: user classes + base style class + type modifier class #}
	{% set classes = settings.classes | merge( [ base_styles.base, 'e-alert-box--' ~ settings.type ] ) | join(' ') %}

	{# Build the ID attribute if set #}
	{% set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}

	{# Choose the icon based on the alert type #}
	{% set icons = {
		'success': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>',
		'error': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>',
		'warning': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>',
		'info': '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>'
	} %}

	<div
		role="alert"
		class="{{ classes }}"
		data-interaction-id="{{ interaction_id }}"
		{{ id_attribute }}
		{{ settings.attributes | raw }}
	>
		{# Icon #}
		<span class="e-alert-box__icon">
			{{ icons[settings.type] | raw }}
		</span>

		{# Content wrapper #}
		<span class="e-alert-box__body">
			{% if settings.title is not empty %}
				<span class="e-alert-box__title">{{ settings.title }}</span>
			{% endif %}

			{% if settings.content is not empty %}
				{% if settings.link and settings.link.attributes is not empty %}
					<{{ settings.link.tag | e('html_tag') }}
						{{ settings.link.attributes | raw }}
						class="e-alert-box__content"
					>
						{{ settings.content | striptags(allowed_tags) | raw }}
					</{{ settings.link.tag | e('html_tag') }}>
				{% else %}
					<span class="e-alert-box__content">
						{{ settings.content | striptags(allowed_tags) | raw }}
					</span>
				{% endif %}
			{% endif %}
		</span>
	</div>

{% endif %}