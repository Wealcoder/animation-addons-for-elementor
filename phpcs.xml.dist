<?xml version="1.0"?>
<ruleset name="AAE-Forms">
	<description>WordPress Coding Standards — scoped to the AAE Form Builder code (the legacy plugin code predates this ruleset and is checked separately when touched).</description>

	<!-- Default scan scope when phpcs is run with no path arguments. -->
	<file>inc/Forms</file>
	<file>inc/AtomicWidgets/Widgets/Form</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- PSR-4 autoloaded classes (Wealcoder\AnimationAddons\ => inc/) use PSR filenames. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short array syntax is used across the whole plugin. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- The form backend runs on six custom aae_* tables; $wpdb is the
		     only way to reach them and WP object caching doesn't apply. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
		<!-- Hook names deliberately use the Elementor-style slash namespace
		     (aaeaddon_form/submission_saved) to match the rest of the plugin. -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
		<!-- Docblock completeness is not enforced retroactively; headers and
		     complex functions are documented, trivial accessors are not. -->
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
	</rule>

	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<!-- wp_kses() with the allow-list a page builder's output needs
				     (SVG, iframe, form, media) and <style> blocks carried beside
				     kses, because kses turns a stray `>` in text into `&gt;`
				     and breaks every child selector. inc/helper.php, inc/Kses.php. -->
				<element value="aaeaddon_kses_builder_html"/>
				<!-- CSS printed inside a <style> element, and only there: core
				     has no escaper for CSS text (esc_html would rewrite `a > b`
				     and every quoted url()), and stripping tags is what closes
				     the one thing CSS text can do to a page: end the block. -->
				<element value="wp_strip_all_tags"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="animation-addons-for-elementor"/>
			</property>
		</properties>
	</rule>
</ruleset>
